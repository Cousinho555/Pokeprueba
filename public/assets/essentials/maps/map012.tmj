 [0, 2], [412, 1], [108, 1, \"Verifica si se trata de un huevo.\"], [111, 1, 12, \"pbGetPokemon(1).egg?\"], [101, 2, \"\\\\bEspera, espera... ¡Eso no es más que un Huevo!\"], [115, 2], [0, 2], [412, 1], [108, 1, \"Verifica si es un Pokémon Oscuro.\"], [111, 1, 12, \"(pbGetPokemon(1).isShadow? rescue false)\"], [101, 2, \"\\\\b¡No me atrevería a juzgar el apodo de un \"], [401, 2, \"Pokémon Oscuro!\"], [115, 2], [0, 2], [412, 1], [111, 1, 12, \"pbGetPokemon(1).isForeign?($Trainer)\"], [101, 2, \"\\\\bMmm... ¡\\\\v[3], eso es!\"], [101, 2, \"\\\\b¡Éste es un excelente apodo! ¡Es impecable e \"], [401, 2, \"irreprochable!\"], [101, 2, \"\\\\bHarás bien en acariciar a tu \\\\v[3] ahora y \"], [401, 2, \"siempre.\"], [115, 2], [0, 2], [412, 1], [101, 1, \"\\\\b¿\\\\v[3], será?\\\\n¡Ése es un apodo simpático!\"], [101, 1, \"\\\\bPero, ¿quieres que le dé un apodo más bonito?\"], [101, 1, \"\\\\b¿Qué te parece?\"], [102, 1, [\"Si\", \"No\"], 2], [402, 1, 0, \"Si\"], [101, 2, \"\\\\bAh, bien. Entonces, ¿cuál será el nuevo apodo?\"], [355, 2, \"pkmn=pbGetPokemon(1)\\nspecies=PBSpecies.getName(pkmn.species)\\npbTextEntry(\\\"Apodo de #{species}:\\\",0,10,5)\"], [111, 2, 12, \"$game_variables[5]==\\\"\\\" || $game_variables[5]==pbGet(3)\"], [355, 3, \"pkmn=pbGetPokemon(1)\\npkmn.name=PBSpecies.getName(\\npkmn.species)\\n$game_variables[3]=pkmn.name\"], [101, 3, \"\\\\b¡Hecho! ¡De ahora en adelante, este Pokémon \"], [401, 3, \"será conocido como \\\\v[3]!\"], [101, 3, \"\\\\b¡Parece estar igual que antes, y, sin embargo, \"], [401, 3, \"es muy superior!\"], [101, 3, \"\\\\b¡Qué afortunado eres!\"], [0, 3], [411, 2], [108, 3, \"Recupera el Pokémon indexado por la variable 1 y \"], [355, 3, \"pkmn=pbGetPokemon(1)\\npkmn.name=pbGet(5)\"], [101, 3, \"\\\\b¡Hecho! ¡De ahora en adelante, este Pokémon \"], [401, 3, \"será conocido como \\\\v[5]!\"], [101, 3, \"\\\\b¡Éste es un mejor apodo que el anterior!\\\\n¡Qué \"], [401, 3, \"afortunado eres!\"], [0, 3], [412, 2], [0, 2], [402, 1, 1, \"No\"], [101, 2, \"\\\\bYa veo.\\\\nVuelve a visitarme.\"], [0, 2], [404, 1], [0, 1], [402, 0, 1, \"No\"], [101, 1, \"\\\\bYa veo.\\\\nVuelve a visitarme.\"], [0, 1], [404, 0], [0, 0]]}]"}]},{"id":3,"name":"Quita Movimiento","type":"evento","point":true,"x":208.0,"y":240.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"id","type":"string","value":"3"},{"name":"vision","type":"string","value":"0"},{"name":"paginas","type":"string","value":"[{\"cond\": {}, \"grafico\": \"trchar014\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[101, 0, \"\\\\bUh...\\\\nOh, si, soy el Eliminador de \"], [401, 0, \"Movimientos.\"], [101, 0, \"\\\\bPuedo hacer que un Pokémon olvide un \"], [401, 0, \"movimiento.\"], [101, 0, \"\\\\b¿Quieres que haga eso?\"], [102, 0, [\"Si\", \"No\"], 2], [402, 0, 0, \"Si\"], [118, 1, \"ChoosePokemon\"], [101, 1, \"\\\\b¿Qué Pokémon quieres que olvide un movimiento?\"], [355, 1, \"pbChoosePokemon(1,3)\"], [108, 1, \"Si la variable 1 es menor que 0, significa que el \"], [111, 1, 1, 1, 0, 0, 4], [101, 2, \"\\\\bRegresa cuando necesites que un Pokémon olvide \"], [401, 2, \"un movimiento.\"], [0, 2], [411, 1], [111, 2, 12, \"pbGetPokemon(1).egg?\"], [101, 3, \"\\\\b¿Qué? Ningún Huevo podría saber un movimiento.\"], [115, 3], [0, 3], [412, 2], [111, 2, 12, \"(pbGetPokemon(1).isShadow? rescue false)\"], [101, 3, \"\\\\b¿Qué? No puedo hacer que un Pokémon Oscuro \"], [401, 3, \"olvide un movimiento.\"], [115, 3], [0, 3], [412, 2], [111, 2, 12, \"pbNumMoves(pbGetPokemon(1))==1\"], [101, 3, \"\\\\b\\\\v[3] parece que conoce un sólo movimiento...\"], [115, 3], [0, 3], [412, 2], [101, 2, \"\\\\b¿Cuál movimiento debería olvidar?\"], [355, 2, \"pbChooseMove(pbGetPokemon(1),2,4)\"], [111, 2, 1, 2, 0, 0, 4], [119, 3, \"ChoosePokemon\"], [0, 3], [411, 2], [101, 3, \"\\\\b¡Mmm! ¿Quieres que \\\\v[3] olvide \\\\v[4]?\"], [102, 3, [\"Si\", \"No\"], 2], [402, 3, 0, \"Si\"], [249, 4, {\"nombre\": \"013-Gag02\", \"volumen\": 100, \"tono\": 100}], [106, 4, 80], [355, 4, \"pbDeleteMove(pbGetPokemon(1),\\npbGet(2))\"], [101, 4, \"\\\\b¡Funcionó a la perfección!\"], [101, 4, \"\\\\b\\\\v[3] ha olvidado \\\\v[4] por completo.\"], [0, 4], [402, 3, 1, \"No\"], [101, 4, \"\\\\bRegresa cuando necesites que un Pokémon olvide \"], [401, 4, \"un movimiento.\"], [0, 4], [404, 3], [0, 3], [412, 2], [0, 2], [412, 1], [0, 1], [402, 0, 1, \"No\"], [101, 1, \"\\\\bRegresa cuando necesites que un Pokémon olvide \"], [401, 1, \"un movimiento.\"], [0, 1], [404, 0], [0, 0]]}]"}]},{"id":4,"name":"Recuerda Movimientos","type":"evento","point":true,"x":176.0,"y":240.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"id","type":"string","value":"4"},{"name":"vision","type":"string","value":"0"},{"name":"paginas","type":"string","value":"[{\"cond\": {}, \"grafico\": \"NPC 06\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[111, 0, 12, \"isTempSwitchOff?(\\\"A\\\")\"], [101, 1, \"\\\\bSoy el Maníaco de Movimientos Pokémon.\"], [101, 1, \"\\\\bConozco cada uno de los movimientos que un \"], [401, 1, \"Pokémon aprende en su crecimiento.\"], [101, 1, \"\\\\bTambién soy un coleccionista de Escamas \"], [401, 1, \"Corazón.\"], [101, 1, \"\\\\bSi me traes una, le enseñaré un movimiento a \"], [401, 1, \"uno de tus Pokémon.\"], [355, 1, \"setTempSwitchOn(\\\"A\\\")\"], [0, 1], [412, 0], [111, 0, 12, \"$PokemonBag.pbQuantity(PBItems::HEARTSCALE)>0\"], [101, 1, \"\\\\b¡Oh! ¡Eso es! ¡Esa es una íntegra y \"], [401, 1, \"maravillosa Escama Corazón!\"], [101, 1, \"\\\\bDéjame adivinar, ¿quieres que le enseñe un \"], [401, 1, \"movimiento a uno de tus Pokémon?\"], [102, 1, [\"Si\", \"No\"], 2], [402, 1, 0, \"Si\"], [118, 2, \"ChoosePokemon\"], [101, 2, \"\\\\b¿Cuál Pokémon necesita tutoría?\"], [355, 2, \"pbChoosePokemon(1,3,proc{|p|\\n pbHasRelearnableMove?(p)\\n},true)\"], [108, 2, \"Si la variable 1 es menor que 0, significa que el \"], [111, 2, 1, 1, 0, 0, 4], [101, 3, \"\\\\bSi tu Pokémon necesita aprender un movimiento, \"], [401, 3, \"regresa con una Escama Corazón.\"], [0, 3], [411, 2], [111, 3, 12, \"pbGetPokemon(1).egg?\"], [101, 4, \"\\\\b¿Cuac? No hay ningún movimiento que pueda \"], [401, 4, \"enseñarle a un huevo.\"], [119, 4, \"ChoosePokemon\"], [0, 4], [412, 3], [111, 3, 12, \"(pbGetPokemon(1).isShadow? rescue false)\"], [101, 4, \"\\\\bDe ninguna forma, no quiero acercarme a ningún \"], [401, 4, \"Pokémon Oscuro...\"], [119, 4, \"ChoosePokemon\"], [0, 4], [412, 3], [111, 3, 12, \"!pbHasRelearnableMove?(pbGetPokemon(1))\"], [101, 4, \"\\\\bLo siento...\"], [101, 4, \"\\\\bParece que no hay ningún movimiento que pueda \"], [401, 4, \"enseñarle a tu \\\\v[3].\"], [119, 4, \"ChoosePokemon\"], [0, 4], [412, 3], [101, 3, \"\\\\b¿Qué movimiento debería enseñarle a tu \\\\v[3]?\"], [111, 3, 12, \"pbRelearnMoveScreen(pbGetPokemon(1))\"], [355, 4, \"$PokemonBag.pbDeleteItem(PBItems::HEARTSCALE)\"], [101, 4, \"\\\\PN entregó una Escama Corazón a cambio.\"], [101, 4, \"\\\\bSi tu Pokémon necesita aprender un movimiento, \"], [401, 4, \"regresa con una Escama Corazón.\"], [0, 4], [411, 3], [101, 4, \"\\\\bSi tu Pokémon necesita aprender un movimiento, \"], [401, 4, \"regresa con una Escama Corazón.\"], [0, 4], [412, 3], [0, 3], [412, 2], [0, 2], [402, 1, 1, \"No\"], [101, 2, \"\\\\bSi tu Pokémon necesita aprender un movimiento, \"], [401, 2, \"regresa con una Escama Corazón.\"], [0, 2], [404, 1], [0, 1], [411, 0], [101, 1, \"\\\\bSi tu Pokémon necesita aprender un movimiento, \"], [401, 1, \"regresa con una Escama Corazón.\"], [0, 1], [412, 0], [0, 0]]}]"}]},{"id":5,"name":"Tutor Movimientos","type":"evento","poin
"], [0, 1], [402, 0, 1, \"No\"], [101, 1, \"\\\\rDaisy: Oh, de acuerdo.\"], [0, 1], [404, 0], [0, 0]]}]"}]},{"id":3,"name":"Dr Footstep","type":"evento","point":true,"x":48.0,"y":144.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"id","type":"string","value":"3"},{"name":"vision","type":"string","value":"0"},{"name":"paginas","type":"string","value":"[{\"cond\": {}, \"grafico\": \"NPC 07\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[101, 0, \"\\\\bDr. Footstep: ¡Hola! ¡Yo califico las huellas \"], [401, 0, \"de los Pokémon!\"], [101, 0, \"\\\\bDr. Footstep: ¿Puedo calificar uno de tus \"], [401, 0, \"Pokémon?\"], [102, 0, [\"Si\", \"No\"], 2], [402, 0, 0, \"Si\"], [101, 1, \"\\\\bDr. Footstep: ¿A cuál Pokémon quieres que \"], [401, 1, \"califique?\"], [355, 1, \"pbChooseNonEggPokemon(1,2)\"], [111, 1, 1, 1, 0, 0, 4], [101, 2, \"\\\\bDr. Footstep: Bueno, tal vez la próxima vez.\"], [115, 2], [0, 2], [412, 1], [355, 1, \"poke=pbGetPokemon(1)\\nh=poke.happiness\\nstage=0\\nstage=1 if h>=1\\nstage=2 if h>=50\\nstage=3 if h>=100\\nstage=4 if h>=150\\nstage=5 if h>=200\\nstage=6 if h>=255\\npbSet(3,stage)\"], [111, 1, 1, 3, 0, 0, 0], [101, 2, \"\\\\bDr. Footstep: Por casualidad, tú... ¿Eres una \"], [401, 2, \"persona muy estricta? Siento que a tu \\\\v[2] no \"], [401, 2, \"le agradas del todo...\"], [0, 2], [412, 1], [111, 1, 1, 3, 0, 1, 0], [101, 2, \"\\\\bDr. Footstep: Mmm... A tu \\\\v[2] no le agradas \"], [401, 2, \"mucho.\"], [0, 2], [412, 1], [111, 1, 1, 3, 0, 2, 0], [101, 2, \"\\\\bDr. Footstep: La afinidad no es buena ni \"], [401, 2, \"mala... Tu \\\\v[2] parece neutral.\"], [0, 2], [412, 1], [111, 1, 1, 3, 0, 3, 0], [101, 2, \"\\\\bDr. Footstep: Tu \\\\v[2] es un poco amable \"], [401, 2, \"contigo... Eso es lo que estoy entendiendo.\"], [0, 2], [412, 1], [111, 1, 1, 3, 0, 4, 0], [101, 2, \"\\\\bDr. Footstep: Tu \\\\v[2] es amable contigo. \"], [401, 2, \"Parece ser feliz contigo.\"], [0, 2], [412, 1], [111, 1, 1, 3, 0, 5, 0], [101, 2, \"\\\\bDr. Footstep: ¡Tu \\\\v[2] es bastante amistoso \"], [401, 2, \"contigo! ¡Pareces ser una persona amable!\"], [0, 2], [412, 1], [111, 1, 1, 3, 0, 6, 0], [101, 2, \"\\\\bDr. Footstep: ¡Tu \\\\v[2] es muy amistoso \"], [401, 2, \"contigo! ¡Estoy un poco celoso!\"], [355, 2, \"p=pbGetPokemon(1)\\nn=(p.hasRibbon?(:FOOTPRINT)) ? 1 : 0\\npbSet(4,n)\"], [111, 2, 1, 4, 0, 0, 0], [101, 3, \"\\\\bDr. Footstep: ¡Voy a recompensar a tu \\\\v[2] \"], [401, 3, \"con una cinta!\"], [355, 3, \"poke=pbGetPokemon(1)\\npoke.giveRibbon(:FOOTPRINT)\"], [101, 3, \"\\\\PN recibió la Cinta Footprint. \\\\se\"], [401, 3, \"[itemlevel]\\\\wtnp[20]\"], [101, 3, \"\\\\PN puso la Cinta Footprint en \\\\v[2].\"], [0, 3], [412, 2], [0, 2], [412, 1], [0, 1], [402, 0, 1, \"No\"], [101, 1, \"\\\\bDr. Footstep: Bueno, tal vez la próxima vez.\"], [0, 1], [404, 0], [0, 0]]}]"}]},{"id":4,"name":"Juez Cinta Esfuerzo","type":"evento","point":true,"x":80.0,"y":144.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"id","type":"string","value":"4"},{"name":"vision","type":"string","value":"0"},{"name":"paginas","type":"string","value":"[{\"cond\": {}, \"grafico\": \"NPC 04\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[108, 0, \"Revisa los EVs totales del primer Pokémon, y lo \"], [355, 0, \"p=$Trainer.pokemonParty[0]\\nev=0\\nfor i in 0...6\\n  ev+=p.ev[i]\\nend\\nmaxed=(ev>=255) ? 1 : 0\\nmaxed=2 if p.hasRibbon?(:EFFORT)\\npbSet(1,p.name)\\npbSet(2,maxed)\"], [101, 0, \"\\\\r¿Ah?\\\\nTu \\\\v[1]...\"], [111, 0, 1, 2, 0, 2, 0], [101, 1, \"\\\\r¡Oh! ¡Tu \\\\v[1], esa Cinta Esfuerzo le queda \"], [401, 1, \"muy bien!\"], [0, 1], [411, 0], [111, 1, 1, 2, 0, 1, 0], [101, 2, \"\\\\r¡Lo está haciendo estupéndamente!\"], [101, 2, \"\\\\rComo recompensa, por favor, dale esta Cinta \"], [401, 2, \"Esfuerzo.\"], [355, 2, \"poke=$Trainer.pokemonParty[0]\\npoke.giveRibbon(:EFFORT)\"], [101, 2, \"\\\\PN recibió la Cinta Esfuerzo. \\\\se\"], [401, 2, \"[itemlevel]\\\\wtnp[20]\"], [101, 2, \"\\\\PN puso la Cinta Esfuerzo en \\\\v[1].\"], [0, 2], [411, 1], [101, 2, \"\\\\rTienes que hacerlo con más esmero.\"], [101, 2, \"\\\\rSi lo haces, le daré a tu Pokémon algo \"], [401, 2, \"hermoso.\"], [0, 2], [412, 1], [0, 1], [412, 0], [0, 0]]}]"}]},{"id":5,"name":"Juez Cinta Concurso","type":"evento","point":true,"x":112.0,"y":144.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"id","type":"string","value":"5"},{"name":"vision","type":"string","value":"0"},{"name":"paginas","type":"string","value":"[{\"cond\": {}, \"grafico\": \"trchar020\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[108, 0, \"Entrega o mejora una cinta de concurso al primer \"], [101, 0, \"\\\\r¡Hola! ¡Soy la Dama del Concurso!\"], [101, 0, \"\\\\rYo reparto cintas de concurso. ¿Quieres una?\"], [102, 0, [\"Si\", \"No\"], 2], [402, 0, 0, \"Si\"], [355, 1, \"p=$Trainer.pokemonParty[0]\\nret=p.upgradeRibbon(:HOENNCOOL,\\n                    :HOENNCOOLSUPER,\\n                    :HOENNCOOLHYPER,\\n                    :HOENNCOOLMASTER)\\npbSet(1,ret)\\npbSet(2,p.name)\\nif ret>0\\n  pbSet(3,PBRibbons.getName(ret))\\nend\"], [111, 1, 1, 1, 0, 0, 0], [101, 2, \"\\\\rLo siento, tu \\\\v[2] ya tiene la mayor \"], [401, 2, \"calificación de la Cinta Cool.\"], [0, 2], [411, 1], [101, 2, \"\\\\PN ha recibido \\\\v[3]. \\\\se[itemlevel]\\\\wtnp[20]\"], [101, 2, \"\\\\PN puso \\\\v[3] en \\\\v[2].\"], [0, 2], [412, 1], [0, 1], [402, 0, 1, \"No\"], [101, 1, \"\\\\rEs tu decisión.\"], [0, 1], [404, 0], [0, 0]]}]"}]},{"id":6,"name":"Evalúa Características","type":"evento","point":true,"x":272.0,"y":144.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"id","type":"string","value":"6"},{"name":"vision","type":"string","value":"0"},{"name":"paginas","type":"string","value":"[{\"cond\": {}, \"grafico\": \"NPC 10\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[101, 0, \"\\\\bSi quieres, puedo evaluar el potencial \"], [401, 0, \"intrigante de tu Pokémon.\"], [102, 0, [\"Si\", \"No\"], 2], [402, 0, 0, \"Si\"], [101, 1, \"\\\\b¿A cuál Pokémon quieres que evalúe?\"], [355, 1, \"pbChooseNonEggPokemon(1,2)\"], [111, 1, 1, 1, 0, 0, 4], [101, 2, \"\\\\b...¿Ah? No necesitas mi evaluación. Lo \"], [401, 2, \"entiendo.\"], [115, 2], [0, 2], [412, 1], [355, 1, \"p=pbGetPokemon(1)\\nsum=0\\nfor i in 0...6; sum+=p.iv[i]; end\\nquote=_I(\\\"es bueno en general\\\")\\nquote=_I(\\\"está sobre la media\\\") if sum>90\\nquote=_I(\\\"es relativamente superior a lo \\nnormal\\\") if sum>120\\nquote=_I(\\\"es excepcional\\\") if sum>150\\npbSet(2,quote)\"], [101, 1, \"\\\\bYa veo, ya veo...\"], [101, 1, \"\\\\bEl potencial de este Pokémon \\\\v[2].\"], [101, 1, \"\\\\bÉsa es mi resolución, y es final.\"], [355, 1, \"p=pbGetPokemon(1)\\nbest=[]; val=-1\\nfor i in [0,1,2,4,5,3]\\n  if p.iv[i]>val\\n    best=[i]; val=p.iv[i]\\n  elsif p.iv[i]==val\\n    best.push(i)\\n  end\\nend\\npbSet(2,best)\\npbSet(3,val)\"], [355, 1, \"best=pbGet(2)\\nstat=[_I(\\\"PS\\\"),_I(\\\"Ataque\\\"),\\n      _I(\\\"Defensa\\\"),_I(\\\"Velocidad\\\"),\\n      _I(\\\"Ataque Especial\\\"),\\n      _I(\\\"Defensa Especial\\\")][best[0]]\\npbSet(4,stat)\\npbSet(5,best.length-1)\"], [101, 1, \"\\\\bAdicionalmente, yo diría que su mejor \"], [401, 1, \"potencial está en su \\\\v[4].\"], [112, 1], [111, 2, 1, 5, 0, 0, 3], [355, 3, \"best=pbGet(2)\\nbest[0]=nil; best.compact!\\npbSet(2,best)\\nstat=[_I(\\\"Su Ataque también es bueno.\\\"),\\n      _I(\\\"Su Defensa también es buena.\\\"),\\n      _I(\\\"Su Velocidad también es buena.\\\"),\\n      _I(\\\"Su poder de Ataque Especial es \\nigualmente bueno.\\\"),\\n      _I(\\\"Su Defensa Especial es igualmente \\nbuena.\\\")][best[0]-1]\\npbSet(4,stat)\"], [101, 3, \"\\\\b\\\\v[4]\"], [122, 3, 5, 5, 2, 0, 1], [0, 3], [411, 2], [113, 3], [0, 3], [412, 2], [0, 2], [413, 1], [355, 1, \"val=pbGet(3)\\nstage=0\\nstage=1 if val>15\\nstage=2 if val>25\\nstage=3 if val>30\\nquote=[_I(\\\"Es bastante decente\\\"),\\n       _I(\\\"Es muy bueno\\\"),\\n       _I(\\\"Es fantástico\\\"),\\n       _I(\\\"No puede ser mejor\\\")][stage]\\npbSet(4,quote)\"], [101, 1, \"\\\\b\\\\v[4] en ese aspecto. Esa es mi evaluación.\"], [0, 1], [402, 0, 1, \"No\"], [101, 1, \"\\\\b...¿Ah? No necesitas mi evaluación. Lo \"], [401, 1, \"entiendo.\"], [0, 1], [404, 0], [0, 0]]}]"}]}]}],"tilesets":[{"firstgid":1,"name":"autotiles3","image":"../autotiles/3.png","imagewidth":256,"imageheight":1344,"tilewidth":32,"tileheight":32,"tilecount":336,"columns":8,"margin":0,"spacing":0},{"firstgid":337,"name":"Interior general","image":"../tilesets/Interior general.png","imagewidth":2048,"imageheight":1024,"tilewidth":32,"tileheight":32,"tilecount":2048,"columns":64,"margin":0,"spacing":0}]}
, 2], [111, 2, 1, 1, 0, 2, 0], [101, 3, \"Después de cada victoria, podrás cambiar uno de \"], [401, 3, \"tus Pokémon por uno de los del Entrenador \"], [401, 3, \"derrotado.\"], [101, 3, \"No podrás hacer trueque de Pokémon con el \"], [401, 3, \"séptimo Entrenador.\"], [119, 3, \"Choices\"], [0, 3], [412, 2], [111, 2, 1, 1, 0, 3, 0], [101, 3, \"A la hora de trocar Pokémon, debes tener en \"], [401, 3, \"cuenta dos cosas.\"], [101, 3, \"Primera: en el momento del trueque, no podrás \"], [401, 3, \"ver las características del Pokémon que vas a \"], [401, 3, \"recibir.\"], [101, 3, \"Segunda: los Pokémon de tu equipo se mostrarán \"], [401, 3, \"siguiendo el orden en el que los elegiste.\"], [101, 3, \"Ese orden no se altera aunque luego realices \"], [401, 3, \"trueques.\"], [119, 3, \"Choices\"], [0, 3], [412, 2], [0, 2], [402, 1, 1, \"Reproducir el combate grabado\"], [111, 2, 12, \"$PokemonGlobal.lastbattle!=nil\"], [355, 3, \"pbPlayLastBattle\"], [0, 3], [411, 2], [101, 3, \"No hay ningún combate grabado.\"], [0, 3], [412, 2], [0, 2], [402, 1, 2, \"Salir\"], [0, 2], [404, 1], [0, 1], [412, 0], [0, 0]]}]"}]},{"id":7,"name":"PNJ Batallas Dobles","type":"evento","point":true,"x":336.0,"y":112.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"id","type":"string","value":"7"},{"name":"vision","type":"string","value":"0"},{"name":"paginas","type":"string","value":"[{\"cond\": {}, \"grafico\": \"trchar028\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[101, 0, \"\\\\b¡Te doy una calurosa bienvenido a la Fábrica \"], [401, 0, \"Batalla!\"], [101, 0, \"\\\\b¿Quieres participar en una batalla doble?\"], [102, 0, [\"Si\", \"No\"], 2], [402, 0, 0, \"Si\"], [355, 1, \"pbBattleChallenge.set(\\\"factorydoubleopen\\\",7,\\npbBattleFactoryRules(false,true))\"], [111, 1, 1
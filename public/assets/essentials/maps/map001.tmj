n","type":"string","value":"0"},{"name":"paginas","type":"string","value":"[{\"cond\": {}, \"grafico\": \"\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 3, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[104, 0, 1, 1], [101, 0, \"<ac>\\\\c[8]\\\\l[3](Para obtener más\\\\ninformación, \"], [401, 0, \"consulta la\\\\nPokémon Essentials Wiki.)\"], [104, 0, 2, 0], [221, 0], [241, 0, {\"nombre\": \"Introduction\", \"volumen\": 100, \"tono\": 100}], [231, 0, 1, \"introbg\", 0, 0, 0, 0, 100, 100, 255, 0], [222, 0, \"\"], [106, 0, 18], [231, 0, 3, \"introOak\", 1, 0, 256, 150, 100, 100, 0, 0], [232, 0, 3, 15, 1, 0, 256, 150, 100, 100, 255, 0], [106, 0, 18], [101, 0, \"\\\\tg[Profesor Oak]\\\\b¡Hola y bienvenido a la demo \"], [401, 0, \"tecnica de Pokémon Essentials BES!\"], [101, 0, \"\\\\tg[Profesor Oak]\\\\bEn esta demo podrás ver \"], [401, 0, \"ejemplos de como se usa Pokémon Essentials para \"], [401, 0, \"que luego puedas aplicarlo en tu propio \"], [401, 0, \"proyecto.\"], [101, 0, \"\\\\tg[Profesor Oak]\\\\bPor ejemplo, puedes tomar \"], [401, 0, \"esta intro como base.\"], [118, 0, \"Help Choices\"], [101, 0, \"\\\\tg[Profesor Oak]\\\\bAntes de continuar, \"], [401, 0, \"¿necesitas algo más?\"], [102, 0, [\"Controles\", \"Sobre Pokémon Essentials BES\", \"No necesito nada\"], 3], [402, 0, 0, \"Controles\"], [355, 1, \"pbEventScreen(ButtonEventScene)\"], [119, 1, \"Help Choices\"], [0, 1], [402, 0, 1, \"Sobre Pokémon Essentials BES\"], [101, 1, \"\\\\tg[Profesor Oak]\\\\bMuy bien, sin mas vueltas...\"], [355, 1, \"pbToneChangeAll(Tone.new(-255,-255,-255,0),10)\"], [106, 1, 10], [231, 1, 4, \"helpadventurebg\", 0, 0, 0, 0, 100, 100, 0, 0], [232, 1, 4, 10, 0, 0, 0, 0, 100, 100, 255, 0], [106, 1, 10], [104, 1, 1, 1], [101, 1, \"<ac>\\\\c[0]\\\\l[3]Pokémon Essentials BES, es un fork \"], [401, 1, \"no oficial de Pokémon Essentials v16.2 y el \"], [401, 1, \"sucesor de la llamada “Base de Pira”. \"], [101, 1, \"<ac>\\\\c[0]\\\\l[5]Este trae de forma funcional todos \"], [401, 1, \"los pokemon, movimientos y habilidades hasta la \"], [401, 1, \"9ª Generación.\"], [101, 1, \"<ac>\\\\c[0]\\\\l[3]Además de algunas correcciones, \"], [401, 1, \"QoL importantes y algunos ajustes \"], [401, 1, \"para compatibilizar métodos con los de nuevas \"], [401, 1, \"versiones.\"], [101, 1, \"<ac>\\\\c[0]\\\\l[3]Todo manteniendo el espíritu de la \"], [401, 1, \"base de no añadir más de lo estrictamente \"], [401, 1, \"necesario, y siempre integrándolo con el código \"], [401, 1, \"original para mayor compatibilidad.\"], [232, 1, 4, 10, 0, 0, 0, 0, 100, 100, 0, 0], [106, 1, 10], [235, 1, 4], [355, 1, \"pbToneChangeAll(Tone.new(0,0,0,0),10)\"], [106, 1, 10], [104, 1, 2, 0], [119, 1, \"Help Choices\"], [0, 1], [402, 0, 2, \"No necesito nada\"], [0, 1], [404, 0], [106, 0, 5], [232, 0, 3, 30, 1, 0, 340, 150, 100, 100, 255, 0], [106, 0, 40], [250, 0, {\"nombre\": \"Battle jump to ball\", \"volumen\": 80, \"tono\": 100}], [355, 0, \"pbToneChangeAll(Tone.new(\\n255,255,255,255),5)\"], [106, 0, 5], [231, 0, 4, \"introMarill\", 1, 0, 256, 220, 100, 100, 0, 0], [232, 0, 4, 10, 1, 0, 256, 220, 100, 100, 255, 0], [355, 0, \"pbToneChangeAll(Tone.new(\\n0,0,0,0),5)\"], [106, 0, 5], [355, 0, \"pbPlayCry(PBSpecies::MARILL)\"], [101, 0, \"\\\\tg[Profesor Oak]\\\\bEste mundo está habitado por \"], [401, 0, \"criaturas llamadas Pokémon.\"], [101, 0, \"\\\\tg[Profesor Oak]\\\\bLos humanos y los Pokémon \"], [401, 0, \"vivimos juntos como amigos.\"], [101, 0, \"\\\\tg[Profesor Oak]\\\\bA veces jugamos y otras \"], [401, 0, \"trabajamos codo con codo.\\\\nHay quien combate con \"], [401, 0, \"sus Pokémon para estrechar lazos con ellos.\"], [106, 0, 5], [232, 0, 4, 10, 1, 0, 256, 220, 100, 100, 0, 0], [232, 0, 3, 30, 1, 0, 256, 150, 100, 100, 255, 0], [106, 0, 40], [235, 0, 4], [101, 0, \"\\\\tg[Profesor Oak]\\\\bPero aún no lo sabemos
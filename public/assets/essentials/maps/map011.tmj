":"paginas","type":"string","value":"[{\"cond\": {}, \"grafico\": \"trchar028\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[111, 0, 2, \"B\", 1], [101, 1, \"\\\\b¡Oh, hola! Soy un científico.\"], [101, 1, \"\\\\b¡Puedo hacer de los fósiles unos Pokémon \"], [401, 1, \"vivitos y coleando!\"], [123, 1, \"B\", 0], [0, 1], [411, 0], [101, 1, \"\\\\b¡Vaya! ¡Tú de nuevo!\"], [0, 1], [412, 0], [355, 0, \"pbChooseItemFromList(\\n_I(\\\"<c2=6546675A>¿Tienes un fósil que \\nquieras revivir?\\\"),9,\\n:HELIXFOSSIL,:DOMEFOSSIL,:OLDAMBER,\\n:ROOTFOSSIL,:CLAWFOSSIL,\\n:SKULLFOSSIL,:ARMORFOSSIL,\\n:COVERFOSSIL,:PLUMEFOSSIL)\"], [111, 0, 1, 9, 0, -1, 0], [108, 1, \"El jugador canceló la elección de un fósil.\"], [101, 1, \"\\\\bAvísame cuando necesites que te reviva un \"], [401, 1, \"fósil.\"], [0, 1], [411, 0], [111, 1, 1, 9, 0, 0, 0], [108, 2, \"El jugador no tiene ningún fósil.\"], [0, 2], [411, 1], [108, 2, \"El jugador ha elegido un fósil.\"], [355, 2, \"$PokemonBag.pbDeleteItem(pbGet(9))\"], [355, 2, \"$game_variables[3]=PBItems.getName(pbGet(9))\"], [101, 2, \"\\\\bDe acuerdo. Veré si puedo revivir tu \\\\v[3].\"], [101, 2, \"\\\\bRegresa después.\"], [108, 2, \"Convierte el fósil en una especie ahora.\"], [355, 2, \"pbConvertItemToPokemon(9,[\\n:HELIXFOSSIL,:OMANYTE,\\n:DOMEFOSSIL,:KABUTO,\\n:OLDAMBER,:AERODACTYL,\\n:ROOTFOSSIL,:LILEEP,\\n:CLAWFOSSIL,:ANORITH,\\n:SKULLFOSSIL,:CRANIDOS,\\n:ARMORFOSSIL,:SHIELDON,\\n:COVERFOSSIL,:TIRTOUGA,\\n:PLUMEFOSSIL,:ARCHEN])\"], [123, 2, \"A\", 0], [121, 2, 13, 13, 0], [0, 2], [412, 1], [0, 1], [412, 0], [0, 0]]}, {\"cond\": {\"ss\": \"A\"}, \"grafico\": \"trchar028\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[111, 0, 1, 9, 0, 0, 3], [101, 1, \"\\\\b¿Dónde estuviste? Ya pude revivir tu fósil.\"], [355, 1, \"$game_variables[3]=PBSpecies.getName(pbGet(9))\"], [101, 1, \"\\\\bEra \\\\v[3] como lo pensé.\"], [111, 1, 12, \"pbAddToParty(pbGet(9),1)\"], [122, 2, 9, 9, 0, 0, 0], [123, 2, \"A\", 1], [0, 2], [411, 1], [101, 2, \"\\\\bNo tienes espacio. Vuelve cuando lo tengas.\"], [0, 2], [412, 1], [0, 1], [411, 0], [101, 1, \"\\\\bHice de todo para revivir tu fósil.\"], [101, 1, \"\\\\bSin embargo, lo que traje de vuelta no \"], [401, 1, \"sobrevivió...\\\\1 afortunadamente.\"], [101, 1, \"\\\\bLo siento.\"], [123, 1, \"A\", 1], [0, 1], [412, 0], [0, 0]]}, {\"cond\": {\"s1\": 13}, \"grafico\": \"trchar028\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[101, 0, \"\\\\bTe dije que regreses después.\"], [0, 0]]}]"}]},{"id":3,"name":"PC","type":"evento","point":true,"x":48.0,"y":48.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"id","type":"string","value":"3"},{"name":"vision","type":"string","value":"0"},{"name":"paginas","type":"string","value":"[{\"cond\": {}, \"grafico\": \"\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[355, 0, \"pbPokeCenterPC\"], [0, 0]]}]"}]}]}],"tilesets":[{"firstgid":1,"name":"autotiles3","image":"../autotiles/3.png","imagewidth":256,"imageheight":1344,"tilewidth":32,"tileheight":32,"tilecount":336,"columns":8,"margin":0,"spacing":0},{"firstgid":337,"name":"Interior general","image":"../tilesets/Interior general.png","imagewidth":2048,"imageheight":1024,"tilewidth":32,"tileheight":32,"tilecount":2048,"columns":64,"ma
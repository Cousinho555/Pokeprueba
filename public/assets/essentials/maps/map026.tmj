oke.setAbility(2)   # Hidden Ability\\npoke.setNature(:MODEST)\\npoke.ballused=15     # Cherish Ball\\npoke.makeShiny\\npoke.calcStats\"], [101, 2, \"\\\\r¡Cuida mucho de Bulbito!\"], [123, 2, \"A\", 0], [0, 2], [411, 1], [101, 2, \"\\\\rOh, no tienes más espacio.\"], [0, 2], [412, 1], [0, 1], [402, 0, 1, \"No\"], [101, 1, \"\\\\rOh, es una pena.\"], [0, 1], [404, 0], [0, 0]]}, {\"cond\": {\"ss\": \"A\"}, \"grafico\": \"NPC 08\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[101, 0, \"\\\\r¡Espero que estés cuidando mucho a mi Bulbito!\"], [0, 0]]}]"}]},{"id":5,"name":"Intercambio avanzado","type":"evento","point":true,"x":112.0,"y":208.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"id","type":"string","value":"5"},{"name":"vision","type":"string","value":"0"},{"name":"paginas","type":"string","value":"[{\"cond\": {}, \"grafico\": \"trchar042\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[101, 0, \"\\\\rEstoy buscando un Dragonair hembra.\"], [101, 0, \"\\\\r¿Quieres intercambiarlo por mi Dodrio?\"], [102, 0, [\"Si\", \"No\"], 2], [402, 0, 0, \"Si\"], [108, 1, \"Dado que hay más condiciones que solamente un \"], [108, 1, \"Observa que dos especificaciones por defecto son \"], [355, 1, \"pbChoosePokemon(1,2,\\nproc {|poke|\\n !poke.isEgg? &&\\n !(poke.isShadow? rescue false) &&\\n poke.gender==1 &&\\n poke.species==PBSpecies::DRAGONAIR\\n})\"], [111, 1, 1, 1, 0, -1, 0], [101, 2, \"\\\\r¿No quieres intercambiar? Bah...\"], [0, 2], [411, 1], [101, 2, \"\\\\r¡De acuerdo! ¡Comencemos!\"], [108, 2, \"Este intercambio proporciona un Dodrio especial con \"], [108, 2, \"Recuerda agregar \\\"poke.calcStats\\\" al final. Ésto \"], [355, 2, \"p=PokeBattle_Pokemon.new(:DODRIO,\\n   pbGetPokemon(1).level,$Trainer)\\np.setItem(:SMOKEBALL)\\np.makeFemale\\np.setAbility(0)         # Run Away\\np.setNature(:IMPISH)\\np.iv=[20,20,20,15,15,15]\\np.ballused=10           # Luxury Ball\\np.pbLearnMove(:SURF)\\np.calcStats\"], [355, 2, \"pbStartTrade(pbGet(1),p,\\n_I(\\\"Doris\\\"),_I(\\\"Ayana\\\"),1)\"], [108, 2, \"El intercambio en sí establece el apodo, movimientos, \"], [101, 2, \"¡\\\\PN intercambió Dragonair por Dodrio!\"], [101, 2, \"\\\\r¡Gracias!\"], [123, 2, \"A\", 0], [0, 2], [412, 1], [0, 1], [402, 0, 1, \"No\"], [101, 1, \"\\\\r¿No quieres intercambiar? Bah...\"], [0, 1], [404, 0], [0, 0]]}, {\"cond\": {\"ss\": \"A\"}, \"grafico\": \"trchar042\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[101, 0, \"\\\\r¿Estás cuidando muy bien de Doris?\"], [0, 0]]}]"}]},{"id":6,"name":"Regala Pkm - Básico","type":"evento","point":true,"x":272.0,"y":208.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"id","type":"string","value":"6"},{"name":"vision","type":"string","value":"0"},{"name":"paginas","type":"string","value":"[{\"cond\": {}, \"grafico\": \"trchar022\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[101, 0, \"\\\\bMi Shuckie es un gran Pokémon, pero no puedo \"], [401, 0, \"continuar entrenándolo.\"], [101, 0, \"\\\\b¿Quieres adoptar a Shuckie y hacerlo crecer \"], [401, 0, \"como se merece?\"], [102, 0, [\"Si\", \"No\"], 2], [402, 0, 0, \"Si\"], [108, 1, \"pbAddForeignPokemon puede agregar un Pokémon \"], [111, 1, 12, \"pbAddForeignPokemon(:SHUCKLE,20,_I(\
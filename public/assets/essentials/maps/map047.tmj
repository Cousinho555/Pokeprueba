tring","value":"trchar028"},{"name":"direccion","type":"string","value":"4"},{"name":"patron","type":"string","value":"0"},{"name":"atraviesa","type":"string","value":"false"},{"name":"disparo","type":"string","value":"0"},{"name":"texto","type":"string","value":"[\"Puedo contarte algunas cosas sobre los Pokémon Oscuros en Essentials. Sin embargo, la wiki tiene mucha más información sobre ellos.\", \"¿Qué quieres saber?\"]"}]},{"id":8,"name":"Oficial","type":"evento","point":true,"x":304.0,"y":368.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"grafico","type":"string","value":"NPC 01"},{"name":"direccion","type":"string","value":"2"},{"name":"patron","type":"string","value":"0"},{"name":"atraviesa","type":"string","value":"false"},{"name":"disparo","type":"string","value":"2"},{"name":"texto","type":"string","value":"[\"Estoy aquí para detener tu paso por aquí.\", \"El nombre de mi evento es \\\"Oficial\\\" y el Detonante de Inicio \\\"Colisionar\\\" me dice que me active en cuanto pasas por estos dos pasos frente a mí.\", \"El script Kernel.pbExclaim sirve para mostrar un signo de exclamasión. El script Kernel.pbNoticePlayer hace lo mismo, además hace que me aproxime a tí.\", \"Los entrenadores usan estas características por defecto, pero cualquier otro PNJ como yo también podemos usarlas. Los eventos Roadblock, en particular, adoran estas funciones.\", \"¿Quieres que te haga retroceder como un verdadero bloqueo de ruta (roadblock)? ¿O prefieres que desactive el bloqueo?\"]"}]},{"id":9,"name":"PNJ dependiente hora","type":"evento","point":true,"x":592.0,"y":208.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"grafico","type":"string","value":"NPC 01"},{"name":"direccion","type":"string","value":"2"},{"name":"patron","type":"string","value":"0"},{"name":"atraviesa","type":"string","value":"false"},{"name":"disparo","type":"string","value":"0"},{"name":"texto","type":"string","value":"[\"¡Hola! Ésto es de lo que digo cuando me llamas durante el día.\"]"}]},{"id":10,"name":"Roca","type":"evento","point":true,"x":1424.0,"y":496.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"grafico","type":"string","value":"Object rock"},{"name":"direccion","type":"string","value":"2"},{"name":"patron","type":"string","value":"0"},{"name":"atraviesa","type":"string","value":"false"},{"name":"disparo","type":"string","value":"0"}]},{"id":11,"name":"Roca","type":"evento","point":true,"x":1872.0,"y":464.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"grafico","type":"string","value":"Object rock"},{"name":"direccion","type":"string","value":"2"},{"name":"patron","type":"string","value":"0"},{"name":"atraviesa","type":"string","value":"false"},{"name":"disparo","type":"string","value":"0"}]},{"id":12,"name":"Controlador clima","type":"evento","point":true,"x":1584.0,"y":656.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"grafico","type":"string","value":"NPC 21"},{"name":"direccion","type":"string","value":"2"},{"name":"patron","type":"string","value":"0"},{"name":"atraviesa","type":"string","value":"false"},{"name":"disparo","type":"string","value":"0"},{"name":"texto","type":"string","value":"[\"Yo puedo controlar el clima. ¿Qué clima te gustaría ver?\"]"}]}]}],"tilesets":[{"firstgid":1,"name":"autotiles1","image":"../autotiles/1.png","imagewidth":256,"imageheight":1344,"tilewidth":32,"tileheight":32,"tilecount":336,"columns":8,"margin":0,"spacing":0},{"firstgid":337,"name":"Outside","image":"../tilesets/Outside.png","imagewidth":2048,"imageheight":2016,"tilewidth":32,"tileheight":32,"tilecount":4032,"columns":64,"margin":0,"spacing":0}]}
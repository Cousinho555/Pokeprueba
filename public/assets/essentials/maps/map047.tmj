[209, 1, 0, {\"repite\": false, \"salta\": false, \"lista\": [[15, [2]], [17, []], [15, [2]], [18, []], [15, [2]], [19, []], [15, [2]], [0, []]]}], [210, 1], [355, 1, \"pbEraseThisEvent\"], [355, 1, \"Kernel.pbRockSmashRandomEncounter\"], [0, 1], [412, 0], [0, 0]]}]"}]},{"id":4,"name":"Duelo PNJ","type":"evento","point":true,"x":1104.0,"y":464.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"id","type":"string","value":"4"},{"name":"vision","type":"string","value":"0"},{"name":"paginas","type":"string","value":"[{\"cond\": {}, \"grafico\": \"trchar031\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[101, 0, \"\\\\b¡Haiiiii-yaaaaaah!\"], [247, 0], [242, 0, 1], [106, 0, 20], [241, 0, {\"nombre\": \"002-Battle02\", \"volumen\": 100, \"tono\": 100}], [108, 0, \"Minijuego de Duelo, basado en la versión escrita por \"], [108, 0, \"Los duelos ocupan un espacio de 4 pasos en fila, con \"], [108, 0, \"3 mensajes para defensa, 3 para ataque, 3 para \"], [355, 0, \"$speeches=[]\\n$speeches.push(\\n\\\"¡Bloquearé todos tus ataques!\\\",\\n\\\"¡Nada puede perforar mi armadura!\\\",\\n\\\"¡Mira mi habilidad para esquivar!\\\",\\n\\\"¡Te mostraré mis habilidades de combate!\\\",\\n\\\"¡Teme la perfección de mis habilidades!\\\",\\n\\\"¡Daré un golpe perfecto!\\\",\\n\\\"¡Siente mi poder!\\\",\\n\\\"¡AAAAHHHH!\\\",\\n\\\"¡Ataqué con toda mi fuerza!\\\")\"], [108, 0, \"3 mensajes de ataques especiales.\"], [355, 0, \"$speeches.push(\\n\\\"¡Observa mi técnica secreta!\\\",\\n\\\"¡Ésta es mi técnica secreta!\\\",\\n\\\"¡Golpe de la Cuchilla del Mal!\\\"\\n)\"], [108, 0, \"Solamente se necesita definir el tipo de entrenador. \"], [111, 0, 12, \"Kernel.pbDuel(PBTrainers::BLACKBELT,\\\"Dan\\\",get_character(0),$speeches)\"], [242, 1, 1], [106, 1, 20], [248, 1], [101, 1, \"\\\\b¡Ganaste, buen trabajo!\"], [0, 1], [411, 0], [242, 1, 1], [106, 1, 20], [248, 1], [101, 1, \"Perdiste, qué mal.\"], [0, 1], [412, 0], [0, 0]]}]"}]},{"id":5,"name":"Entrenador Oscuro básico","type":"evento","point":true,"x":464.0,"y":592.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"id","type":"string","value":"5"},{"name":"vision","type":"string","value":"0"},{"name":"paginas","type":"string","value":"[{\"cond\": {}, \"grafico\": \"trchar056\", \"dir\": 6, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[355, 0, \"pbTrainerIntro(:TEAMROCKET_M)\"], [101, 0, \"\\\\bSoy un entrenador básico con un Pokémon \"], [401, 0, \"Oscuro.\"], [111, 0, 12, \"pbTrainerBattle(PBTrainers::TEAMROCKET_M,\\\"Rocket\\\",_I(\\\"¡Eres demasiado bueno para mí!\\\"),false,1)\", {\"clase\": \"Recluta Team\", \"nombre\": \"Rocket\", \"sprite\": 56, \"dinero\": 32, \"derrota\": \"¡Eres demasiado bueno para mí!\", \"equipo\": [[\"WEEPINBELL\", 21, []]]}], [123, 1, \"A\", 0], [0, 1], [412, 0], [355, 0, \"pbTrainerEnd\"], [0, 0]]}, {\"cond\": {\"ss\": \"A\"}, \"grafico\": \"trchar056\", \"dir\": 6, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[101, 0, \"\\\\b¿Has conseguido arrebatarme el Pokémon Oscuro? \"], [401, 0, \"Porque no podría volver a pelear para darte otra \"], [401, 0, \"oportunidad.\"], [0, 0]]}]"}]},{"id":6,"name":"Entrenador Oscuro revancha","type":"evento","point":true,"x":464.0,"y":624.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"id","type":"string","value":"6"},{"name":"vision","type":"string","value":"0"},{"name":"paginas","type":"string","value":"[{\"cond\": {}, \"grafico\": \"trchar057\", \"dir\": 6, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[355, 0, \"pbTrainerIntro(:TEAMROCKET_F)\"], [101, 0, \"\\\\rPodemos combatir repetidas veces y tendrás \"], [401, 0, \"incontables oportunidades de arrebatarme mi \"], [401, 0, \"Pokémon Oscuro.\"], [111, 0, 12, \"pbTrainerBattle(PBTrainers::TEAMROCKET_F,\\\"Rocket\\\",_I(\\\"¡Eres demasiado bueno para mí!\\\"),false,1)\", {\"clase\": \"Recluta Team\", \"nombre\": \"Rocket\", \"sprite\": 57, \"dinero\": 32, \"derrota\": \"¡Eres demasiado bueno para mí!\", \"equipo\": [[\"BURMY\", 19, []], [\"WINGULL\", 19, []], [\"ELECTABUZZ\", 20, []]]}], [111, 1, 12, \"$Trainer.shadowcaught[PBSpecies::ELECTABUZZ]\"], [123, 2, \"A\", 0], [0, 2], [412, 1], [0, 1], [412, 0], [355, 0, \"pbTrainerEnd\"], [0, 0]]}, {\"cond\": {\"ss\": \"A\"}, \"grafico\": \"trchar057\", \"dir\": 6, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[101, 0, \"\\\\rHas conseguido arrebatarme mi Electabuzz \"], [401, 0, \"Oscuro. Ahora no quiero hacer nada más.\"], [0, 0]]}]"}]},{"id":7,"name":"Experto Purificación","type":"evento","point":true,"x":592.0,"y":720.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"id","type":"string","value":"7"},{"name":"vision","type":"string","value":"0"},{"name":"paginas","type":"string","value":"[{\"cond\": {}, \"grafico\": \"trchar028\", \"dir\": 4, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[101, 0, \"\\\\bPuedo contarte algunas cosas sobre los Pokémon \"], [401, 0, \"Oscuros en Essentials. Sin embargo, la wiki \"], [401, 0, \"tiene mucha más información sobre ellos.\"], [118, 0, \"Choices\"], [101, 0, \"\\\\b¿Qué quieres saber?\"], [102, 0, [\"Información\", \"Combate con Pokémon Oscuro\", \"Purificación de Pokémon\", \"Salir\"], 4], [402, 0, 0, \"Información\"], [101, 1, \"\\\\bLos Pokémon Oscuros son un tipo especial de \"], [401, 1, \"Pokémon que aparecen en Pokémon Colosseum y \"], [401, 1, \"Pokémon XD.\"], [101, 1, \"\\\\bPero también se pueden incluir en Essentials. \"], [401, 1, \"Consulta la documentación de la wiki para más \"], [401, 1, \"detalles sobre el tema.\"], [119, 1, \"Choices\"], [0, 1], [402, 0, 1, \"Combate con Pokémon Oscuro\"], [101, 1, \"\\\\bLos Entrenadores con Pokémon Oscuros son \"], [401, 1, \"configurados exactamente de la misma manera que \"], [401, 1, \"cualquier otro entrenador.\"], [101, 1, \"\\\\bSe puede definir cualquier Poké Ball como Cepo \"], [401, 1, \"Ball en items.txt, también se pueden usar todas \"], [401, 1, \"automáticamente seteando \"], [401, 1, \"$PokemonGlobal.snagMachine en TRUE.\"], [355, 1, \"$PokemonGlobal.snagMachine=true\"], [101, 1, \"\\\\b$Trainer.shadowcaught es una matriz (como las \"], [401, 1, \"matrices de vistos/atrapados de la Pokédex) con \"], [401, 1, \"la que se puede trazar las especies de Pokémon \"], [401, 1, \"Oscuros que fueron capturados.\"], [119, 1, \"Choices\"], [0, 1], [402, 0, 2, \"Purificación de Pokémon\"], [101, 1, \"\\\\bSe pueden purificar los Pokémon Oscuros de dos \"], [401, 1, \"maneras.\"], [101, 1, \"\\\\bLa primera, es llevándolos a la Piedra Antigua \"], [401, 1, \"de allí.\"], [101, 1, \"\\\\bLa segunda, es colocándolos en la Cámara de \"], [401, 1, \"Purificación, que se puede acceder desde la PC \"], [401, 1, \"de un Centro Pokémon.\"], [111, 1, 12, \"!$PokemonGlobal.seenPurifyChamber\"], [101, 2, \"\\\\bTe habilité ahora el acceso a la Cámara de \"], [401, 2, \"Purificación.\"], [355, 2, \"$PokemonGlobal.seenPurifyChamber=true\"], [0, 2], [412, 1], [101, 1, \"\\\\bLos efectos de los objetos para bajar el \"], [401, 1, \"medidor del corazón están disponibles en \"], [401, 1, \"Essentials. Sólo tienes que añadir dichos \"], [401, 1, \"objetos en items.txt.\"], [119, 1, \"Choices\"], [0, 1], [402, 0, 3, \"Salir\"], [0, 1], [404, 0], [0, 0]]}]"}]},{"id":8,"name":"Reliquia de Piedra","type":"evento","point":true,"x":496.0,"y":752.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"id","type":"string","value":"8"},{"name":"vision","type":"string","value":"0"},{"name":"paginas","type":"string","value":"[{\"cond\": {}, \"grafico\": \"\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[355, 0, \"pbRelicStone\"], [0, 0]]}]"}]},{"id":9,"name":"Oficial","type":"evento","point":true,"x":304.0,"y":368.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"id","type":"string","value":"9"},{"name":"vision","type":"string","value":"0"},{"name":"paginas","type":"string","value":"[{\"cond\": {}, \"grafico\": \"NPC 01\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 2, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[355, 0, \"Kernel.pbExclaim(get_character(0))\"], [101, 0, \"\\\\bEstoy aquí para detener tu paso por aquí.\"], [101, 0, \"\\\\bEl nombre de mi evento es \\\"Oficial\\\" y el \"], [401, 0, \"Detonante de Inicio \\\"Colisionar\\\" me dice que me \"], [401, 0, \"active en cuanto pasas por estos dos pasos \"], [401, 0, \"frente a mí.\"], [101, 0, \"\\\\bEl script Kernel.pbExclaim sirve para mostrar \"], [401, 0, \"un signo de exclamasión. El script \"], [401, 0, \"Kernel.pbNoticePlayer hace lo mismo, además hace \"], [401, 0, \"que me aproxime a tí.\"], [101, 0, \"\\\\bLos entrenadores usan estas características \"], [401, 0, \"por defecto, pero cualquier otro PNJ como yo \"], [401, 0, \"también podemos usarlas. Los eventos Roadblock, \"], [401, 0, \"en particular, adoran estas funciones.\"], [101, 0, \"\\\\b¿Quieres que te haga retroceder como un \"], [401, 0, \"verdadero bloqueo de ruta (roadblock)? ¿O \"], [401, 0, \"prefieres que desactive el bloqueo?\"], [102, 0, [\"Bloquear ruta\", \"Desactivar\"], 0], [402, 0, 0, \"Bloquear ruta\"], [209, 1, -1, {\"repite\": false, \"salta\": false, \"lista\": [[22, []], [12, []], [0, []]]}], [210, 1], [0, 1], [402, 0, 1, \"Desactivar\"], [101, 1, \"\\\\b¡De acuerdo! Voy a validar mis propias \"], [401, 1, \"condiciones de bloqueo de ruta, es decir, \"], [401, 1, \"cambiaré el Interruptor Global del que dependo \"], [401, 1, \"(5) a encendido (ON).\"], [121, 1, 5, 5, 0], [0, 1], [404, 0], [0, 0]]}, {\"cond\": {\"s1\": 5}, \"grafico\": \"NPC 01\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[101, 0, \"\\\\bNormalmente, los eventos de bloqueo de ruta no \"], [401, 0, \"se accionan por sí mismos, sino que simplemente \"], [401, 0, \"esperan las condiciones (Interruptor Global 5, \"], [401, 0, \"en mi caso), pero lo hice por vos.\"], [0, 0]]}]"}]},{"id":10,"name":"PNJ dependiente hora","type":"evento","point":true,"x":592.0,"y":208.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"id","type":"string","value":"10"},{"name":"vision","type":"string","value":"0"},{"name":"paginas","type":"string","value":"[{\"cond\": {}, \"grafico\": \"NPC 01\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[101, 0, \"\\\\b¡Hola! Ésto es de lo que digo cuando me \"], [401, 0, \"llamas durante el día.\"], [0, 0]]}, {\"cond\": {\"s1\": 15}, \"grafico\": \"NPC 01\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[101, 0, \"\\\\b¡Alto! ¿Quién anda ahí?\"], [101, 0, \"\\\\bÉsta es mi frase cuando vienes durante la \"], [401, 0, \"noche.\"], [0, 0]]}]"}]},{"id":11,"name":"Roca","type":"evento","point":true,"x":1424.0,"y":496.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"id","type":"string","value":"11"},{"name":"vision","type":"string","value":"0"},{"name":"paginas","type":"string","value":"[{\"cond\": {}, \"grafico\": \"Object rock\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[209, 0, 0, {\"repite\": false, \"salta\": false, \"lista\": [[16, []], [0, []]]}], [111, 0, 12, \"Kernel.pbRockSmash\"], [209, 1, 0, {\"repite\": false, \"salta\": false, \"lista\": [[15, [2]], [17, []], [15, [2]], [18, []], [15, [2]], [19, []], [15, [2]], [0, []]]}], [210, 1], [355, 1, \"pbEraseThisEvent\"], [355, 1, \"Kernel.pbRockSmashRandomEncounter\"], [0, 1], [412, 0], [0, 0]]}]"}]},{"id":12,"name":"Roca","type":"evento","point":true,"x":1872.0,"y":464.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"id","type":"string","value":"12"},{"name":"vision","type":"string","value":"0"},{"name":"paginas","type":"string","value":"[{\"cond\": {}, \"grafico\": \"Object rock\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"
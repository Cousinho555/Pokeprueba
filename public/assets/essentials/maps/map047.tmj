, [412, 0], [108, 0, \"Sol abrazador.\"], [111, 0, 1, 1, 0, 7, 0], [355, 1, \"$game_screen.weather(\\n   PBFieldWeather::Sun,9.0,20)\"], [101, 1, \"\\\\bEste clima puede darse incluso durante la \"], [401, 1, \"noche y no se termina. Es mejor que no lo \"], [401, 1, \"utilices.\"], [0, 1], [412, 0], [101, 0, \"\\\\bObserva que los metadatos del clima de este \"], [401, 0, \"mapa está seteado, incluso si su probabilidad \"], [401, 0, \"está en 0. Esto evita que el clima persista \"], [401, 0, \"cuando salga del mapa.\"], [0, 0]]}]"}]}]}],"tilesets":[{"firstgid":1,"name":"autotiles1","image":"../autotiles/1.png","imagewidth":256,"imageheight":1344,"tilewidth":32,"tileheight":32,"tilecount":336,"columns":8,"margin":0,"spacing":0},{"firstgid":337,"name":"Outside","image":"../tilesets/Outside.png","imagewidth":2048,"imageheight":2016,"tilewidth":32,"tileheight":32,"tilecount":4032,"columns":64,"margin":0,"spacing":0}]}
1, 0, 1, 1, 0, 3, 0], [223, 1, [-255.0, -255.0, -255.0, 0.0], 6], [106, 1, 8], [201, 1, 0, 21, 16, 26, 2, 1], [223, 1, [0.0, 0.0, 0.0, 0.0], 6], [0, 1], [412, 0], [111, 0, 1, 1, 0, 4, 0], [223, 1, [-255.0, -255.0, -255.0, 0.0], 6], [106, 1, 8], [201, 1, 0, 69, 28, 12, 2, 1], [223, 1, [0.0, 0.0, 0.0, 0.0], 6], [0, 1], [412, 0], [111, 0, 1, 1, 0, 5, 0], [223, 1, [-255.0, -255.0, -255.0, 0.0], 6], [106, 1, 8], [201, 1, 0, 71, 8, 3, 2, 1], [223, 1, [0.0, 0.0, 0.0, 0.0], 6], [0, 1], [412, 0], [111, 0, 1, 1, 0, 6, 0], [223, 1, [-255.0, -255.0, -255.0, 0.0], 6], [106, 1, 8], [201, 1, 0, 46, 11, 6, 4, 1], [223, 1, [0.0, 0.0, 0.0, 0.0], 6], [0, 1], [412, 0], [0, 0]]}]"}]},{"id":12,"name":"Choices NPC","type":"evento","point":true,"x":304.0,"y":240.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"id","type":"string","value":"12"},{"name":"vision","type":"string","value":"0"},{"name":"paginas","type":"string","value":"[{\"cond\": {}, \"grafico\": \"NPC 08\", \"dir\": 6, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[101, 0, \"\\\\rEl comando de evento \\\"Choices\\\" no acepta más \"], [401, 0, \"que 4 opciones. Ésto es lo que deberías hacer en \"], [401, 0, \"su lugar.\"], [108, 0, \"Se guarda el resultado en la Variable 1.\"], [101, 0, \"Por favor, elije una opción.\\\\ch[1,-1,Opción \"], [401, 0, \"1,Opción 2,Opción 3,Opción 4,Opción 5,Opción 6]\"], [111, 0, 1, 1, 0, -1, 0], [101, 1, \"La elección fue cancelada.\"], [0, 1], [412, 0], [111, 0, 1, 1, 0, 0, 0], [101, 1, \"La opción 1 fue tomada.\"], [0, 1], [412, 0], [111, 0, 1, 1, 0, 1, 0], [101, 1, \"La opción 2 fue tomada.\"], [0, 1], [412, 0], [111, 0, 1, 1, 0, 2, 0], [101, 1, \"La opción 3 fue tomada.\"], [0, 1], [412, 0], [111, 0, 1, 1, 0, 3, 0], [101, 1, \"La opción 4 fue tomada.\"], [0, 1], [412, 0], [111, 0, 1, 1, 0, 4, 0], [101, 1, \"La opción 5 fue tomada.\"], [0, 1], [412, 0], [111, 0, 1, 1, 0, 5, 0], [101, 1, \"La opción 6 fue tomada.\"], [0, 1], [412, 0], [108, 0, \"Se guarda el resultado en la Variable 1.\"], [101, 0, \"Por favor, elije una opción. Esta selección no \"], [401, 0, \"puede ser cancelada.\\\\ch[1,0,Opción 1,Opción 2]\"], [111, 0, 1, 1, 0, 0, 0], [101, 1, \"La opción 1 fue tomada.\"], [0, 1], [412, 0], [111, 0, 1, 1, 0, 1, 0], [101, 1, \"La opción 2 fue tomada.\"], [0, 1], [412, 0], [101, 0, \"Los comandos de elecciones múltiples como éste \"], [401, 0, \"son habilitados usando el comando de mensaje \\\\\"], [401, 0, \"\\\\ch.\"], [101, 0, \"El área entre corchetes después de \\\\\\\\ch consiste \"], [401, 0, \"en una variable para almacenar la selección, una \"], [401, 0, \"opción por defecto en caso de que el jugador \"], [401, 0, \"cancele, y luego una serie de opciones.\"], [101, 0, \"Si la opción por defecto es puesta en 0, el \"], [401, 0, \"jugador no puede cancelar.\"], [0, 0]]}]"}]},{"id":13,"name":"Text formatting NPC","type":"evento","point":true,"x":336.0,"y":240.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"id","type":"string","value":"13"},{"name":"vision","type":"string","value":"0"},{"name":"paginas","type":"string","value":"[{\"cond\": {}, \"grafico\": \"NPC 07\", \"dir\": 4, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[118, 0, \"Start\"], [101, 0, \"Elije una opción de texto.\"], [102, 0, [\"Colores y formatos\", \"Mostrando cosas extras\", \"Otros\", \"Salir\"], 4], [402, 0, 0, \"Colores y formatos\"], [101, 1, \"\\\\bÉste es el texto de un personaje masculino. \"], [401, 1, \"\\\\rÉste es el texto de un personaje femenino.\"], [101, 1, \"\\\\pgEste texto es del color del género del \"], [401, 1, \"jugador. \\\\pogEste texto es del color del género \"], [401, 1, \"opuesto al jugador.\"], [101, 1, \"\\\\c[0]Texto por defecto, \\\\c[1]texto azul, \\\\c[2]\"], [401, 1, \"texto rojo, \\\\c[3] texto verde, \\\\c[4]texto cian, \"], [401, 1, \"\\\\c[5]texto magenta, \\\\c[6] texto amarillo, \\\\c[7]\"], [401, 1, \"texto gris, \\\\c[8]texto blanco.\"], [101, 1, \"<b>Texto en negritas,</b> <i>texto en \"], [401, 1, \"cursiva,</i> <u>texto subrayado,</u> <s>texto \"], [401, 1, \"tachado,</s> <outln>texto de esquema,</outln> \"], [401, 1, \"<outln2>texto de esquema más grueso.</outln2>\"], [101, 1, \"<fn=Arial>Texto Arial,</fn> <fs=25>tamaño de \"], [401, 1, \"texto 25,</fs> <fs=40>tamaño de texto 40,</fs> \"], [401, 1, \"<o=128>texto medio transparente.</o>\"], [101, 1, \"Ésto es un salto\\\\nde línea. Texto\\\\n<r>alineado a \"], [401, 1, \"la derecha hasta el siguiente salto\\\\n de línea. \"], [401, 1, \"Texto <ac>centrado</ac> aquí. Texto <ar>alineado \"], [401, 1, \"a la derecha</ar> aquí.\"], [119, 1, \"Start\"], [0, 1], [402, 0, 1, \"Mostrando cosas extras\"], [101, 1, \"\\\\PN es el nombre del jugador, \\\\PM es el dinero \"], [401, 1, \"del jugador, \\\\v[12] es el contenido de la \"], [401, 1, \"Variable 12.\"], [101, 1, \"\\\\GSe muestra la ventana de dinero.\"], [101, 1, \"\\\\CNSe muestra la ventana de monedas.\"], [101, 1, \"\\\\G\\\\CNSe muestran las ventanas de dinero y \"], [401, 1, \"monedas juntas. La ventana de monedas es la \"], [401, 1, \"segunda.\"], [101, 1, \"\\\\f[introBoy]Se muestra la imagen introBoy de la \"], [401, 1, \"carpeta Graphics/Pictures.\"], [101, 1, \"\\\\ff[introBoy]Se muestra la imagen introBoy de \"], [401, 1, \"nuevo, pero recortada 96x96 pixeles de la \"], [401, 1, \"esquina superior izquierda.\"], [101, 1, \"Éste es el <icon=bagPocket3> bagPocket3 de la \"], [401, 1, \"carpeta Graphics/Icons. Los íconos mostrados de \"], [401, 1, \"esta forma no son padded.\"], [119, 1, \"Start\"], [0, 1], [402, 0, 2, \"Otros\"], [101, 1, \"\\\\w[signskin]La windowskin ha cambiado a \"], [401, 1, \"\\\"signskin\\\" aquí.\"], [101, 1, \"\\\\l[3]Este cuadro de texto tiene 3 líneas en \"], [401, 1, \"lugar de 2, así que se puede mostrar más texto \"], [401, 1, \"de una sola vez. Lorem ipsum dolor sit amet, \"], [401, 1, \"consectetur adipisicing elit.\"], [101, 1, \"\\\\wuEste cuadro de texto se muestra arriba.\"], [101, 1, \"\\\\wmEste cuadro de texto se muestra en el medio.\"], [101, 1, \"\\\\wuEste cuando de texto está\\\\wm saltando \"], [401, 1, \"alrededor de la pantalla\\\\wd de una manera \"], [401, 1, \"bastante desagradable.\"], [101, 1, \"\\\\opEste cuadro de texto se desliza hacia la \"], [401, 1, \"pantalla al iniciar.\"], [101, 1, \"\\\\clEste cuadro de texto se desliza fuera de la \"], [401, 1, \"pantalla al finalizar.\"], [101, 1, \"\\\\ts[]¡Este texto aparece inmediatamente!\"], [101, 1, \"\\\\ts[5]Este texto es lento.\"], [101, 1, \"\\\\se[itemlevel]El efecto de sonido itemlevel fue \"], [401, 1, \"tocado.\"], [101, 1, \"El efecto de música Jingle - HMTM será tocado. \"], [401, 1, \"\\\\me[Jingle - HMTM]\"], [119, 1, \"Start\"], [0, 1], [402, 0, 3, \"Salir\"], [0, 1], [404, 0], [101, 0, \"Una lista completa de todas las opciones de \"], [401, 0, \"mensajes está disponible en la wiki.\"], [0, 0]]}]"}]},{"id":14,"name":"Pokémon-checking NPC","type":"evento","point":true,"x":48.0,"y":176.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"id","type":"string","value":"14"},{"name":"vision","type":"string","value":"0"},{"name":"paginas","type":"string","value":"[{\"cond\": {}, \"grafico\": \"trchar028\", \"dir\": 6, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[118, 0, \"Choices\"], [101, 0, \"Elige un tema.\"], [102, 0, [\"¿Cuál es tu primer Pokémon?\", \"¿Está Celebi en tu equipo?\", \"Obtener un Celebi\", \"Salir\"], 4], [402, 0, 0, \"¿Cuál es tu primer Pokémon?\"], [108, 1, \"Obtiene el primer Pokémon disponible del equipo y \"], [355, 1, \"pbFirstAblePokemon(1)\"], [111, 1, 1, 1, 0, 0, 4], [101, 2, \"No tienes ningún Pokémon contigo.\"], [0, 2], [411, 1], [108, 2, \"Recupera el Pokémon cuyo índice de equipo está en \"], [355, 2, \"pkmn=pbGetPokemon(1)\\npbSet(2,pkmn.name)\"], [101, 2, \"\\\\v[2] es el primer Pokémon de tu equipo.\"], [0, 2], [412, 1], [119, 1, \"Choices\"], [0, 1], [402, 0, 1, \"¿Está Celebi en tu equipo?\"], [108, 1, \"Cuenta los Pokémon debilitados, sin contar los \"], [111, 1, 12, \"pbHasSpecies?(:CELEBI)\"], [101, 2, \"Tienes un Celebi en tu equipo.\"], [0, 2], [411, 1], [101, 2, \"No tienes un Celebi en tu equipo.\"], [0, 2], [412, 1], [119, 1, \"Choices\"], [0, 1], [402, 0, 2, \"Obtener un Celebi\"], [108, 1, \"Entrega al jugador un Celebi de nivel 20.\"], [108, 1, \"Consulta los eventos del Club de Fanáticos Pokémon \"], [355, 1, \"pbAddPokemon(:CELEBI,20)\"], [0, 1], [402, 0, 3, \"Salir\"], [0, 1], [404, 0], [0, 0]]}]"}]},{"id":15,"name":"Pokémon Errantes","type":"evento","point":true,"x":176.0,"y":48.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"id","type":"string","value":"15"},{"name":"vision","type":"string","value":"0"},{"name":"paginas","type":"string","value":"[{\"cond\": {}, \"grafico\": \"\", \"dir\": 2, \"patron\": 0, \"tile\": 1721, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[118, 0, \"Start\"], [101, 0, \"Elije un Pokémon errante.\"], [102, 0, [\"Latias/Latios\", \"Kyogre\", \"Entei\", \"Salir\"], 4], [402, 0, 0, \"Latias/Latios\"], [111, 1, 0, 53, 0], [101, 2, \"El interruptor 53 está encendido. Latias y \"], [401, 2, \"Latios están deambulando.\"], [0, 2], [411, 1], [101, 2, \"El interruptor 53 está apagado. Latias y Latios \"], [401, 2, \"no están deambulando. ¿Quieres que Latias y \"], [401, 
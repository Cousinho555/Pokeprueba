 quebradizo. Puedes caminar sobre él una sola vez, la segunda vez que lo hagas caerás hasta el otro mapa.\", \"En este caso, \\\"caerás\\\" en una parte distinta del mismo mapa. No hay diferencia si los dos niveles de este mapa estuvieran en dos mapas diferentes.\"]"}]},{"id":3,"name":"Cartel deslizamiento","type":"evento","point":true,"x":1072.0,"y":304.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"grafico","type":"string","value":""},{"name":"direccion","type":"string","value":"2"},{"name":"patron","type":"string","value":"0"},{"name":"atraviesa","type":"string","value":"false"},{"name":"disparo","type":"string","value":"0"},{"name":"texto","type":"string","value":"[\"El hielo sobre el que te deslizas tiene una etiqueta de terreno 12.\"]"}]},{"id":4,"name":"Piedra suelta","type":"evento","point":true,"x":688.0,"y":464.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"grafico","type":"string","value":"Object boulder"},{"name":"direccion","type":"string","value":"2"},{"name":"patron","type":"string","value":"0"},{"name":"atraviesa","type":"string","value":"false"},{"name":"disparo","type":"string","value":"1"}]},{"id":5,"name":"Agujero","type":"evento","point":true,"x":720.0,"y":464.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"grafico","type":"string","value":""},{"name":"direccion","type":"string","value":"2"},{"name":"patron","type":"string","value":"0"},{"name":"atraviesa","type":"string","value":"true"},{"name":"disparo","type":"string","value":"1"},{"name":"warp","type":"string","value":"{\"mapa\": 34, \"x\": 16, \"y\": 30, \"dir\": 0}"}]},{"id":6,"name":"Ladder down","type":"evento","point":true,"x":528.0,"y":528.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"grafico","type":"string","value":""},{"name":"direccion","type":"string","value":"2"},{"name":"patron","type":"string","value":"0"},{"name":"atraviesa","type":"string","value":"false"},{"name":"disparo","type":"string","value":"1"},{"name":"warp","type":"string","value":"{\"mapa\": 34, \"x\": 11, \"y\": 32, \"dir\": 6}"}]},{"id":7,"name":"Ladder up","type":"evento","point":true,"x":336.0,"y":1040.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"grafico","type":"string","value":""},{"name":"direccion","type":"string","value":"2"},{"name":"patron","type":"string","value":"0"},{"name":"atraviesa","type":"string","value":"false"},{"name":"disparo","type":"string","value":"1"},{"name":"warp","type":"string","value":"{\"mapa\": 34, \"x\": 17, \"y\": 16, \"dir\": 6}"}]},{"id":8,"name":"Sliding ice sign","type":"evento","point":true,"x":688.0,"y":944.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"grafico","type":"string","value":""},{"name":"direccion","type":"string","value":"2"},{"name":"patron","type":"string","value":"0"},{"name":"atraviesa","type":"string","value":"false"},{"name":"disparo","type":"string","value":"0"},{"name":"texto","type":"string","value":"[\"Éste es otro acertijo del tipo roca-hueco.\", \"Es idéntico al acertijo regular, salvo que la roca caída es evento inmóvil normal a diferencia de la roca común.\"]"}]}]}],"tilesets":[{"firstgid":1,"name":"autotiles6","image":"../autotiles/6.png","imagewidth":256,"imageheight":1344,"tilewidth":32,"tileheight":32,"tilecount":336,"columns":8,"margin":0,"spacing":0},{"firstgid":337,"name":"Caves","image":"../tilesets/Caves.png","imagewidth":2048,"imageheight":800,"tilewidth":32,"tileheight":32,"tilecount":1600,"columns":64,"margin":0,"spacing":0}]}
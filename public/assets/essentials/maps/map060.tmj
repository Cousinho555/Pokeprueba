een(3,100)\"], [119, 2, \"End\"], [0, 2], [412, 1], [111, 1, 12, \"pbSaveScreen\"], [101, 2, \"\\\\b¡Sígueme, por favor!\"], [355, 2, \"pbBattleChallenge.start\"], [209, 2, 0, {\"repite\": false, \"salta\": false, \"lista\": [[37, []], [15, [4]], [19, []], [4, []], [4, []], [42, [0]], [38, []], [0, []]]}], [209, 2, -1, {\"repite\": false, \"salta\": false, \"lista\": [[37, []], [15, [4]], [19, []], [4, []], [4, []], [4, []], [42, [0]], [38, []], [0, []]]}], [210, 2], [250, 2, {\"nombre\": \"Exit Door\", \"volumen\": 80, \"tono\": 100}], [223, 2, [-255.0, -255.0, -255.0, 0.0], 6], [106, 2, 8], [201, 2, 0, 61, 0, 5, 6, 1], [223, 2, [0.0, 0.0, 0.0, 0.0], 6], [0, 2], [411, 1], [119, 2, \"End\"], [0, 2], [412, 1], [0, 1], [402, 0, 1, \"No\"], [118, 1, \"End\"], [101, 1, \"\\\\bEsperamos que vuelvas pronto por aquí.\"], [355, 1, \"pbBattleChallenge.pbCancel\"], [115, 1], [0, 1], [404, 0], [0, 0]]}, {\"cond\": {\"s1\": 28}, \"grafico\": \"trchar031\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 3, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[108, 0, \"Si gana\"], [111, 0, 12, \"pbBattleChallenge.decision==1\"], [101, 1, \"\\\\bFelicitaciones por la victoria.\"], [101, 1, \"\\\\bAquí tienes este premio.\"], [111, 1, 12, \"!Kernel.pbReceiveItem(PBItems::RARECANDY)\"], [101, 2, \"\\\\bNo tienes espacio. Al menos, has ganado.\"], [0, 2], [412, 1], [111, 1, 12, \"$PokemonTemp.lastbattle!=nil\"], [101, 2, \"\\\\b¿Quieres grabar tu último combate?\"], [102, 2, [\"Si\", \"No\"], 2], [402, 2, 0, \"Si\"], [355, 3, \"pbRecordLastBattle\"], [101, 3, \"\\\\se[expfull]El último combate ha sido grabado.\"], [0, 3], [402, 2, 1, \"No\"], [0, 3], [404, 2], [0, 2], [412, 1], [101, 1, \"Vamos a grabar tu resultado.\\\\wtnp[15]\"], [355, 1, \"pbBattleChallenge.pbEnd\"], [101, 1, \"\\\\bEsperamos que vuelvas pronto por aquí.\"], [115, 1], [0, 1], [412, 0], 
.\"], [101, 1, \"\\\\bUsando a uno de tus Pokémon, captura un \"], [401, 1, \"Pokémon de tipo Bicho para competir.\"], [101, 1, \"\\\\b¿Quieres intentarlo?\"], [102, 1, [\"Si\", \"No\"], 2], [402, 1, 0, \"Si\"], [111, 2, 12, \"pbBoxesFull?\"], [101, 3, \"\\\\bLo siento, tus cajas Pokémon están llenas.\"], [115, 3], [0, 3], [412, 2], [101, 2, \"\\\\bPuedes entrar al Concurso con un sólo Pokémon.\"], [101, 2, \"\\\\bPor favor, escoge con cuál participar.\"], [108, 2, \"Abre una pantalla para elegir un Pokémon que no \"], [355, 2, \"pbChooseAblePokemon(1,2)\"], [111, 2, 1, 1, 0, 0, 4], [108, 3, \"Cancelar cuando se elegía Pokémon.\"], [101, 3, \"\\\\bDe acuerdo. Esperamos que quieras participar \"], [401, 3, \"en el siguiente concurso.\"], [115, 3], [0, 3], [411, 2], [101, 3, \"\\\\bEntonces, participarás con \\\\v[2].\"], [101, 3, \"\\\\bCuidaremos de los otros Pokémon durante el \"], [401, 3, \"concurso.\"], [101, 3, \"Los Pokémon de \\\\PN fueron dejados al Anfitrión \"], [401, 3, \"del Concurso.\\\\se[expfull]\\\\wtnp[20]\"], [101, 3, \"\\\\bAquí están las Competición Balls del concurso.\"], [101, 3, \"\\\\PN recibió 20 Competición Balls.\"], [401, 3, \"\\\\se[itemlevel]\\\\wtnp[20]\"], [101, 3, \"\\\\bEl participante que gane el bicho Pokémon más \"], [401, 3, \"fuerte será el ganador.\"], [101, 3, \"\\\\bTienes 20 minutos.\"], [101, 3, \"\\\\bSi te quedas sin Competición Balls, habrás \"], [401, 3, \"terminado.\"], [101, 3, \"\\\\bPuedes quedarte con el último Pokémon como \"], [401, 3, \"propio.\"], [101, 3, \"\\\\b¡Adelante y atrapa al Pokémon tipo Bicho más \"], [401, 3, \"fuerte que encuentres!\"], [108, 3, \"Setting the map, X and Y where the Contest is \"], [355, 3, \"pbBugContestState.pbSetJudgingPoint(30,5,6)\\npbBugContestState.pbSetReception(29,30)\\npbBugContestState.pbSetContestMap(28)\\npbBugContestState.pbSetPokemon(pbGet(1))\\npbBugContestState.pbStart(20)\"], [209, 3, -1, {\"repite\": false, \"salta\": false, \"lista\": [[37, []], [1, []], [3, []], [3, []], [3, []], [3, []], [3, []], [42, [0]], [38, []], [0, []]]}], [210, 3], [250, 3, {\"nombre\": \"Exit Door\", \"volumen\": 80, \"tono\": 100}], [223, 3, [-255.0, -255.0, -255.0, 0.0], 6], [106, 3, 8], [209, 3, -1, {\"repite\": false, \"salta\": false, \"lista\": [[42, [255]], [0, []]]}], [201, 3, 0, 28, 8, 24, 0, 1], [223, 3, [0.0, 0.0, 0.0, 0.0], 6], [115, 3], [0, 3], [412, 2], [0, 2], [402, 1, 1, \"No\"], [101, 2, \"\\\\bDe acuerdo. Esperamos que quieras participar \"], [401, 2, \"en el siguiente concurso.\"], [0, 2], [404, 1], [0, 1], [411, 0], [108, 1, \"Hoy no es día de Concurso.\"], [101, 1, \"\\\\bLlevamos a cabo los concursos regularmente en \"], [401, 1, \"el Parque. Podrías darle una oportunidad.\"], [0, 1], [412, 0], [0, 0]]}, {\"cond\": {\"s1\": 26}, \"grafico\": \"NPC 01\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 3, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[108, 0, \"Página de evento llamada cuando el concurso se \"], [106, 0, 20], [101, 0, \"\\\\bTodavía te queda tiempo. ¿Quieres terminar \"], [401, 0, \"ahora?\"], [102, 0, [\"Si\", \"No\"], 2], [402, 0, 0, \"Si\"], [101, 1, \"\\\\bDe acuerdo. Espera en el pabellón hasta el \"], [401, 1, \"anuncio del ganador.\"], [355, 1, \"pbBugContestState.pbStartJudging\"], [115, 1], [0, 1], [402, 0, 1, \"No\"], [101, 1, \"\\\\bDe acuerdo. Regresa al parque hasta terminar.\"], [209, 1, -1, {\"repite\": false, \"salta\": false, \"lista\": [[18, []], [15, [4]], [42, [0]], [0, []]]}], [210, 1], [250, 1, {\"nombre\": \"Exit Door\", \"volumen\": 80, \"tono\": 100}], [223, 1, [-255.0, -255.0, -255.0, 0.0], 6], [106, 1, 8], [209, 1, -1, {\"repite\": false, \"salta\": false, \"lista\": [[42, [255]], [0, []]]}], [201, 1, 0, 28, 8, 24, 0, 1], [223, 1, [0.0, 0.0, 0.0, 0.0], 6], [115, 1], [0, 1], [404, 0], [0, 0]]}]"}]}]}],"tilesets":[{"firstgid":1,"name":"autotiles3","image
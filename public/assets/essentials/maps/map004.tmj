tation":0,"visible":true,"properties":[{"name":"grafico","type":"string","value":""},{"name":"direccion","type":"string","value":"2"},{"name":"patron","type":"string","value":"0"},{"name":"atraviesa","type":"string","value":"false"},{"name":"disparo","type":"string","value":"0"},{"name":"texto","type":"string","value":"[\"El evento junto al Profesor contiene los comandos de ejecución automática.\", \"Hay dos clases de eventos: aquellos que suceden cuando el jugar entra en el mapa y aquellos que suceden cuando el jugador ha elegido un inicial.\"]"}]},{"id":8,"name":"Señal der","type":"evento","point":true,"x":240.0,"y":48.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"grafico","type":"string","value":""},{"name":"direccion","type":"string","value":"2"},{"name":"patron","type":"string","value":"0"},{"name":"atraviesa","type":"string","value":"false"},{"name":"disparo","type":"string","value":"0"},{"name":"texto","type":"string","value":"[\"La variable global 7 debería almacenar 1 si el jugador elije el inicial de Planta, 2 si elije al inicial de Fuego y 3 si elije al inicial de Agua.\", \"Esta información puede ser usada más adelante en el juego, por ejemplo, para determinar los Pokémon que utiliza el rival.\"]"}]},{"id":9,"name":"Acceso Dex","type":"evento","point":true,"x":112.0,"y":336.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"grafico","type":"string","value":"trchar028"},{"name":"direccion","type":"string","value":"6"},{"name":"patron","type":"string","value":"0"},{"name":"atraviesa","type":"string","value":"false"},{"name":"disparo","type":"string","value":"0"},{"name":"texto","type":"string","value":"[\"Puedo controlar el acceso a tu Pokédex. ¿Qué quieres que haga?\"]"}]},{"id":10,"name":"Creador Almacenamiento","type":"evento","point":true,"x":304.0,"y":336.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"grafico","type":"string","value":"NPC 25"},{"name":"direccion","type":"string","value":"4"},{"name":"patron","type":"string","value":"0"},{"name":"atraviesa","type":"string","value":"false"},{"name":"disparo","type":"string","value":"0"},{"name":"texto","type":"string","value":"[\"¡Hola! Soy .\", \"Yo diseñé el Sistema de Almacenamiento de Pokémon.\", \"Eso es interesante, ¿verdad?\"]"}]}]}],"tilesets":[{"firstgid":1,"name":"autotiles3","image":"../autotiles/3.png","imagewidth":256,"imageheight":1344,"tilewidth":32,"tileheight":32,"tilecount":336,"columns":8,"margin":0,"spacing":0},{"firstgid":337,"name":"Interior general","image":"../tilesets/Interior general.png","imagewidth":2048,"imageheight":1024,"tilewidth":32,"tileheight":32,"tilecount":2048,"columns":64,"margin":0,"spacing":0}]}
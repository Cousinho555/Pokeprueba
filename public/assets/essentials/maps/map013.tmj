, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[111, 0, 6, -1, 4], [355, 1, \"pbSlotMachine\"], [0, 1], [412, 0], [0, 0]]}]"}]},{"id":15,"name":"Slot Machine 15","type":"evento","point":true,"x":208.0,"y":336.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"id","type":"string","value":"15"},{"name":"vision","type":"string","value":"0"},{"name":"paginas","type":"string","value":"[{\"cond\": {}, \"grafico\": \"\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[111, 0, 6, -1, 4], [355, 1, \"pbSlotMachine\"], [0, 1], [412, 0], [0, 0]]}]"}]},{"id":16,"name":"Coin Case giver","type":"evento","point":true,"x":112.0,"y":80.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"id","type":"string","value":"16"},{"name":"vision","type":"string","value":"0"},{"name":"paginas","type":"string","value":"[{\"cond\": {}, \"grafico\": \"NPC 08\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[101, 0, \"\\\\r¡Bienvenido!\"], [111, 0, 12, \"$PokemonBag.pbQuantity(PBItems::COINCASE)<=0\"], [101, 1, \"\\\\rVaya, ¿no tienes un Monedero? Toma.\"], [111, 1, 12, \"Kernel.pbReceiveItem(PBItems::COINCASE)\"], [101, 2, \"\\\\rPuedes cambiar las monedas por premios \"], [401, 2, \"fabulosos al lado.\"], [0, 2], [411, 1], [101, 2, \"\\\\rNo tienes más espacio. Vuelve cuando lo \"], [401, 2, \"tengas.\"], [0, 2], [412, 1], [0, 1], [411, 0], [101, 1, \"\\\\rPuedes cambiar las monedas por premios \"], [401, 1, \"fabulosos al lado.\"], [0, 1], [412, 0], [0, 0]]}]"}]},{"id":17,"name":"Coin seller","type":"evento","point":true,"x":144.0,"y":80.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"id","type":"string","value":"17"},{"name":"vision","type":"string","value":"0"},{"name":"paginas","type":"string","value":"[{\"cond\": {}, \"grafico\": \"NPC 07\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[101, 0, \"\\\\G\\\\CN\\\\b¡Bienvenido al Rincón del Juego Cohete!\"], [111, 0, 12, \"$PokemonBag.pbQuantity(PBItems::COINCASE)<=0\"], [101, 1, \"\\\\G\\\\CN\\\\b¿Necesitas algunas monedas?\\\\n¿Quieres \"], [401, 1, \"comprar algunas?\"], [101, 1, \"\\\\G\\\\CN\\\\bNo tienes un Monedero.\"], [0, 1], [411, 0], [101, 1, \"\\\\G\\\\CN\\\\b¿Necesitas algunas monedas?\\\\n¿Quieres \"], [401, 1, \"comprar algunas?\"], [102, 1, [\"50 monedas [$1,000]\", \"500 monedas [$10,000]\", \"Salir\"], 3], [402, 1, 0, \"50 monedas [$1,000]\"], [111, 2, 12, \"$PokemonGlobal.coins+50>=MAXCOINS\"], [101, 3, \"\\\\G\\\\CN\\\\b¡Uff!\\\\nTu Monedero está lleno.\"], [0, 3], [411, 2], [111, 3, 7, 999, 1], [101, 4, \"\\\\G\\\\CN\\\\bNo puedes llevar más monedas.\"], [0, 4], [411, 3], [125, 4, 1, 0, 1000], [355, 4, \"$PokemonGlobal.coins+=50\"], [101, 4, \"\\\\G\\\\CN\\\\bGracias\\\\n¡Ten tus monedas!\"], [0, 4], [412, 3], [0, 3], [412, 2], [0, 2], [402, 1, 1, \"500 monedas [$10,000]\"], [111, 2, 12, \"$PokemonGlobal.coins+500>=MAXCOINS\"], [101, 3, \"\\\\G\\\\CN\\\\b¡Uff!\\\\nTu Monedero está lleno.\"], [0, 3], [411, 2], [111, 3, 7, 9999, 1], [101, 4, \"\\\\G\\\\CN\\\\bNo puedes llevar más monedas.\"], [0, 4], [411, 3], [125, 4, 1, 0, 10000], [355, 4, \"$PokemonGlobal.coins+=500\"], [101, 4, \"\\\\G\\\\CN\\\\bGracias\\\\n¡Ten tus monedas!\"], [0, 4], [412, 3], [0, 3], [412, 2], [0, 2], [402, 1, 2, \"Salir\"], [101, 2, \"\\\\G\\\\CN\\\\b¿No?\\\\n¡Por favor, vuelve para jugar \"], [401, 2, \"alguna vez!\"], [0, 2], [404, 1], [0, 1], [412, 0], [0, 0]]}]"}]},{"id":18,"name":"Lottery","type":"evento","point":true,"x":304.0,"y":80.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"id","type":"string","value":"18"},{"name":"vision","type":"string","value":"0"},{"name":"paginas","type":"string","value":"[{\"cond\": {}, \"grafico\": \"NPC 23\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[101, 0, \"\\\\rÉsto es la Pokémon Lottery Corner. Soy \"], [401, 0, \"Felicity, su asistente el día de hoy.\"], [101, 0, \"\\\\rSi el número dibujado coincide con el N° ID de \"], [401, 0, \"alguno de tus Pokémon, podrás ganar regalos \"], [401, 0, \"fabulosos.\"], [101, 0, \"\\\\r¿Quieres revisar los números de la suerte de \"], [401, 0, \"hoy?\"], [102, 0, [\"Si\", \"No\"], 2], [402, 0, 0, \"Si\"], [101, 1, \"\\\\rEn primer lugar, voy a mirar el número de la \"], [401, 1, \"suerte de la Esquina Lotería Pokémon de hoy.\"], [101, 1, \"...\"], [355, 1, \"pbSetLotteryNumber(1)\"], [101, 1, \"\\\\rEl número del Boleto Loto es \\\\v[1].\"], [101, 1, \"\\\\rAhora, veamos si coincide con el N° ID de \"], [401, 1, \"alguno de tus Pokémon.\"], [355, 1, \"pbLottery(pbGet(1),2,3,4)\"], [111, 1, 1, 4, 0, 0, 0], [101, 2, \"\\\\rLo siento. No tenemos ninguna coincidencia...\"], [101, 2, \"\\\\rPor favor, visítanos de nuevo.\"], [0, 2], [411, 1], [111, 2, 1, 3, 0, 1, 0], [101, 3, \"\\\\r¡Felicitaciones!\"], [101, 3, \"\\\\r¡El número ID del \\\\v[2] de tu equipo coincide \"], [401, 3, \"con el del Boleto Loto!\"], [0, 3], [411, 2], [101, 3, \"\\\\r¡Felicitaciones!\"], [101, 3, \"\\\\r¡El número ID del \\\\v[2] guardado en PC \"], [401, 3, \"coincide con el del Boleto Loto!\"], [0, 3], [412, 2], [111, 2, 1, 4, 0, 5, 0], [101, 3, \"\\\\r¡Qué sorpresa! ¡Coincidieron los cinco \"], [401, 3, \"dígitos!\"], [101, 3, \"\\\\r¡Has ganado el premio mayor!\"], [111, 3, 12, \"Kernel.pbReceiveItem(PBItems::MASTERBALL)\"], [101, 4, \"\\\\r¡Por favor, vuelve a visitarnos! ¡Saludos de \"], [401, 4, \"Felicity, tu asistente!\"], [355, 4, \"pbSetEventTime\"], [0, 4], [411, 3], [101, 4, \"\\\\rNo tienes más espacio. Vuelve cuando lo \"], [401, 4, \"tengas.\"], [355, 4, \"setVariable(PBItems::MASTERBALL)\"], [123, 4, \"B\", 0], [0, 4], [412, 3], [0, 3], [412, 2], [111, 2, 1, 4, 0, 4, 0], [101, 3, \"\\\\r¡Coinciden los últimos cuatro dígitos, por lo \"], [401, 3, \"tanto has ganado el primer premio!\"], [111, 3, 12, \"Kernel.pbReceiveItem(PBItems::MAXREVIVE)\"], [101, 4, \"\\\\r¡Por favor, vuelve a visitarnos! ¡Saludos de \"], [401, 4, \"Felicity, tu asistente!\"], [355, 4, \"pbSetEventTime\"], [0, 4], [411, 3], [101, 4, \"\\\\rNo tienes más espacio. Vuelve cuando lo \"], [401, 4, \"tengas.\"], [355, 4, \"setVariable(PBItems::MAXREVIVE)\"], [123, 4, \"B\", 0], [0, 4], [412, 3], [0, 3], [412, 2], [111, 2, 1, 4, 0, 3, 0], [101, 3, \"\\\\r¡Por favor, vuelve a visitarnos! ¡Saludos de \"], [401, 3, \"Felicity, tu asistente!\"], [111, 3, 12, \"Kernel.pbReceiveItem(PBItems::EXPSHARE)\"], [101, 4, \"\\\\r¡Por favor, vuelve a visitarnos! ¡Saludos de \"], [401, 4, \"Felicity, tu asistente!\"], [355, 4, \"pbSetEventTime\"], [0, 4], [411, 3], [101, 4, \"\\\\rNo tienes más espacio. Vuelve cuando lo \"], [401, 4, \"tengas.\"], [355, 4, \"setVariable(PBItems::EXPSHARE)\"], [123, 4, \"B\", 0], [0, 4], [412, 3], [0, 3], [412, 2], [111, 2, 1, 4, 0, 2, 0], [101, 3, \"\\\\r¡Coinciden los últimos dos dígitos, por lo \"], [401, 3, \"tanto has ganado el tercer premio!\"], [111, 3, 12, \"Kernel.pbReceiveItem(PBItems::PPUP)\"], [101, 4, \"\\\\r¡Por favor, vuelve a visitarnos! ¡Saludos de \"], [401, 4, \"Felicity, tu asistente!\"], [355, 4, \"pbSetEventTime\"], [0, 4], [411, 3], [101, 4, \"\\\\rNo tienes más espacio. Vuelve cuando lo \"], [401, 4, \"tengas.\"], [355, 4, \"setVariable(PBItems::PPUP)\"], [123, 4, \"B\", 0], [0, 4], [412, 3], [0, 3], [412, 2], [111, 2, 1, 4, 0, 1, 0], [101, 3, \"\\\\r¡Coincide el último dígito, por lo tanto has \"], [401, 3, \"ganado el cuarto premio!\"], [111, 3, 12, \"Kernel.pbReceiveItem(PBItems::ULTRABALL)\"], [101, 4, \"\\\\r¡Por favor, vuelve a visitarnos! ¡Saludos de \"], [401, 4, \"Felicity, tu asistente!\"], [355, 4, \"pbSetEventTime\"], [0, 4], [411, 3], [101, 4, \"\\\\rNo tienes más espacio. Vuelve cuando lo \"], [401, 4, \"tengas.\"], [355, 4, \"setVariable(PBItems::ULTRABALL)\"], [123, 4, \"B\", 0], [0, 4], [412, 3], [0, 3], [412, 2], [0, 2], [412, 1], [0, 1], [402, 0, 1, \"No\"], [101, 1, \"\\\\rOh, ya veo.\\\\nPor favor, vuelve a visitarnos.\"], [0, 1], [404, 0], [0, 0]]}, {\"cond\": {\"ss\": \"A\"}, \"grafico\": \"NPC 23\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[101, 0, \"\\\\rYa has utilizado el Boleto Loto de hoy. Por \"], [401, 0, \"favor, regresa mañana.\"], [0, 0]]}, {\"cond\": {\"s1\": 24, \"ss\": \"A\"}, \"grafico\": \"NPC 23\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 3, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[123, 0, \"A\", 1], [355, 0, \"setTempSwitchOn(\\\"A\\\")\"], [0, 0]]}, {\"cond\": {\"ss\": \"B\"}, \"grafico\": \"NPC 23\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[101, 0, \"\\\\rTe estaba esperando. Toma el objeto que has \"], [401, 0, \"ganado.\"], [111, 0, 12, \"Kernel.pbReceiveItem(getVariable())\"], [123, 1, \"B\", 1], [355, 1, \"pbSetEventTime\"], [0, 1], [411, 0], [101, 1, \"\\\\rNo tienes más espacio. Vuelve cuando lo \"], [401, 1, \"tengas.\"], [0, 1], [412, 0], [0, 0]]}]"}]},{"id":19,"name":"Triple Triad explainer","type":"evento","point":true,"x":432.0,"y":80.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"id","type":"string","value":"19"},{"name":"vision","type":"string","value":"0"},{"name":"paginas","type":"string","value":"[{\"cond\": {}, \"grafico\": \"NPC 08\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[101, 0, \"\\\\rEstoy aquí para explicar las reglas de Tríada \"], [401, 0, \"Triple.\"], [118, 0, \"Choices\"], [101, 0, \"\\\\r¿Sobre qué tema quieres aprender?\"], [102, 0, [\"Básico\", \"Reglas de juego\", \"Premios\", \"Salir\"], 4], [402, 0, 0, \"Básico\"], [101, 1, \"\\\\rTríada Triple es juego que utiliza unas cartas \"], [401, 1, \"cuadradas especiales ubicadas en un tablero de \"], [401, 1, \"3x3.\"], [101, 1, \"\\\\rCada carta tiene 4 números en ella, uno en \"], [401, 1, \"cada lado. Estos números son las llamadas \"], [401, 1, \"estadísticas.\"], [101, 1, \"\\\\rLos jugadores toman turnos para ubicar las \"], [401, 1, \"cartas en el tablero. Al mismo tiempo, intentan \"], [401, 1, \"capturar y ganar control de las cartas del \"], [401, 1, \"oponente.\"], [101, 1, \"\\\\rAhí es donde los números importan. Si el \"], [401, 1, \"jugador ubica una carta con un número mayor al \"], [401, 1, \"lado de una carta con un número menor, la carta \"], [401, 1, \"rival queda capturada.\"], [101, 1, \"\\\\rPor lo tanto, el objetivo del juego es \"], [401, 1, \"controlar una mayor cantidad de cartas que el \"], [401, 1, \"otro jugar hasta el final del juego.\"], [119, 1, \"Choices\"], [0, 1], [402, 0, 1, \"Reglas de juego\"], [101, 1, \"\\\\rHay varias reglas opcionales que puedes \"], [401, 1, \"aplicar en duelos individuales.\"], [101, 1, \"\\\\rEllos pueden afectar las estadísticas de las \"], [401, 1, \"cartas, cómo capturan a las demás, el marcador y \"], [401, 1, \"las recompensas.\"], [119, 1, \"Choices\"], [0, 1], [402, 0, 2, \"Premios\"], [101, 1, \"\\\\rCuando ganas un juego, recibirás 1 carta \"], [401, 1, \"aleatoria del mazo de tu oponente.\"], [101, 1, \"\\\\rSucede lo misma en la otra situación: si \"], [401, 1, \"pierdes, tienes que dar una de tus cartas a tu \"], [401, 1, \"oponente, elegida al azar.\"], [101, 1, \"\\\\rPuedes cambiar lo que ganas o pierdes en un \"], [401, 1, \"juego usando las regls de juego opcionales.\"], [119, 1, \"Choices\"], [0, 1], [402, 0, 3, \"Salir\"], [0, 1], [404, 0], [0, 0]]}]"}]},{"id":20,"name":"Exit","type":"evento","point":true,"x":304.0,"y":464.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"id","type":"string","value":"20"},{"name":"vision","type":"string","value":"0"},{"name":"paginas","type":"string","value":"[{\"cond\": {}, \"grafico\": \"\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 1, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[250, 0, {\"nombre\": \"Exit Door\", \"volumen\": 80, \"tono\": 100}], [223, 0, [-255.0, -255.0, -255.0, 0.0], 6], [106, 0, 8], [201, 0, 0, 7, 34, 20, 0, 1], [223, 0, [0.0, 0.0, 0.0, 0.0], 6], [0, 0]]}]"}]},{"id":21,"name":"Triple Triad card shop","type":"evento","point":true,"x":464.0,"y":80.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"id","type":"string","value":"21"},{"name":"vision","type":"string","value":"0"},{"name":"paginas","type":"string","value":"[{\"cond\": {}, \"grafico\": \"NPC 19\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[118, 0, \"Shop Start\"], [101, 0, \"\\\\bBienvenido a la Tienda Carta Tríada.\"], [118, 0, \"Choices\"], [102, 0, [\"Comprar Cartas\", \"Vender Cartas\", \"Información\", \"Salir\"], 4], [402, 0, 0, \"Comprar Cartas\"], [355, 1, \"pbBuyTriads\"], [101, 1, \"\\\\b¿Necesitas algo más?\"], [119, 1, \"Choices\"], [0, 1], [402, 0, 1, \"Vender Cartas\"], [355, 1, \"pbSellTriads\"], [101, 1, \"\\\\b¿Necesitas algo más?\"], [119, 1, \"Choices\"], [0, 1], [402, 0, 2, \"Información\"], [101, 1, \"\\\\bAquí puedes comprar cartas nuevas para los \"], [401, 1, \"duelos de Tríada Triple.\"], [101, 1, \"\\\\bLas opciones crecen a medida que encuentras y \"], [401, 1, \"capturas nuevos Pokémon, así que revísalos con \"], [401, 1, \"frecuencia.\"], [101, 1, \"\\\\bY, por supuesto, las cartas Pokémon más \"], [401, 1, \"fuertes cuestan más que las cartas más débiles.\"], [119, 1, \"Shop Start\"], [0, 1], [402, 0, 3, \"Salir\"], [101, 1, \"\\\\bPor favor, vuelve a visitarnos.\"], [0, 1], [404, 0], [0, 0]]}]"}]},{"id":22,"name":"Triple Triad duel","type":"evento","point":true,"x":528.0,"y":176.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"id","type":"string","value":"22"},{"name":"vision","type":"string","value":"0"},{"name":"paginas","type":"string","value":"[{\"cond\": {}, \"grafico\": \"trchar037\", \"dir\": 4, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[101, 0, \"\\\\bEstoy listo para un duelo contigo.\"], [108, 0, \"The two numbers are the min and max level of the \"], [355, 0, \"pbTriadDuel(\\\"Jack\\\",0,5)\"], [0, 0]]}]"}]},{"id":23,"name":"Triple Triad duel with rules","type":"evento","point":true,"x":528.0,"y":208.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"id","type":"string","value":"23"},{"name":"vision","type":"string","value":"0"
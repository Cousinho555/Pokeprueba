\\n  pbWait(16)\\nend\"], [209, 1, 10, {\"repite\": false, \"salta\": false, \"lista\": [[33, []], [0, []]]}], [249, 1, {\"nombre\": \"Pokemon Healing\", \"volumen\": 100, \"tono\": 100}], [106, 1, 58], [122, 1, 6, 6, 0, 0, 0], [209, 1, 10, {\"repite\": false, \"salta\": false, \"lista\": [[34, []], [0, []]]}], [209, 1, 0, {\"repite\": false, \"salta\": false, \"lista\": [[15, [15]], [16, []], [0, []]]}], [210, 1], [111, 1, 12, \"Kernel.pbPokerus?\"], [101, 2, \"\\\\rYour Pokémon may be infected by PokeRus.\"], [101, 2, \"\\\\rLittle is known about the PokeRus except that they \"], [401, 2, \"are microscopic life-forms that attach to Pokémon.\"], [101, 2, \"\\\\rWhile infected, Pokémon are said to grow \"], [401, 2, \"exceptionally well.\"], [121, 2, 2, 2, 0], [0, 2], [411, 1], [101, 2, \"\\\\rThank you for waiting.\"], [101, 2, \"\\\\rWe've restored your Pokémon to full health.\"], [209, 2, 0, {\"repite\": false, \"salta\": false, \"lista\": [[41, [\"NPC 16\", 0, 2, 1]], [15, [10]], [41, [\"NPC 16\", 0, 2, 0]], [0, []]]}], [210, 2], [101, 2, \"\\\\rWe hope to see you again!\"], [0, 2], [412, 1], [0, 1], [402, 0, 1, \"No\"], [101, 1, \"\\\\rWe hope to see you again!\"], [0, 1], [404, 0], [0, 0]]}, {\"cond\": {\"s1\": 1}, \"grafico\": \"NPC 16\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 3, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[101, 0, \"\\\\rFirst, you should restore your Pokémon to full \"], [401, 0, \"health.\"], [314, 0, 0], [209, 0, 0, {\"repite\": false, \"salta\": false, \"lista\": [[17, []], [15, [2]], [0, []]]}], [210, 0], [122, 0, 6, 6, 0, 0, 0], [355, 0, \"for i in 1..$Trainer.pokemonCount\\n  pbSet(6,i)\\n  pbSEPlay(\\\"ballshake\\\")\\n  pbWait(16)\\nend\"], [209, 0, 10, {\"repite\": false, \"salta\": false, \"lista\": [[33, []], [0, []]]}], [249, 0, {\"nombre\": \"Pokemon Healing\", \"volumen\": 100, \"tono\": 100}], [106, 0, 58], [122, 0, 6, 6, 0, 0, 0], [209, 0, 10, {\"repite\": false, \"salta\": false, \"lista\": [[34, []], [0, []]]}], [209, 0, 0, {\"repite\": false, \"salta\": false, \"lista\": [[15, [15]], [16, []], [0, []]]}], [210, 0], [101, 0, \"\\\\rYour Pokémon have been healed to perfect health.\"], [209, 0, 0, {\"repite\": false, \"salta\": false, \"lista\": [[41, [\"NPC 16\", 0, 2, 1]], [15, [10]], [41, [\"NPC 16\", 0, 2, 0]], [0, []]]}], [210, 0], [101, 0, \"\\\\rWe hope you excel!\"], [121, 0, 1, 1, 1], [0, 0]]}]"}]}]}],"tilesets":[{"firstgid":1,"name":"autotiles20","image":"../autotiles/20.png","imagewidth":256,"imageheight":1344,"tilewidth":32,"tileheight":32,"tilecount":336,"columns":8,"margin":0,"spacing":0},{"firstgid":337,"name":"Trainer Tower interior","image":"../tilesets/Trainer Tower interior.png","imagewidth":2048,"imageheight":224,"tilewidth":32,"tileheight":32,"tilecount":448,"columns":64,"margin":0,"spacing":0}]}
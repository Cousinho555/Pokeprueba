"¿Qué capítulo quieres leer?\\\\ch[1,-1,Copas del \"], [401, 2, \"Estadio,Pika Copa,Mini Copa,Poké Copa,Peque \"], [401, 2, \"Copa,Reglas de Batalla,Salir]\"], [111, 2, 1, 1, 0, 0, 0], [101, 3, \"Este servicio te permite participar de batallas \"], [401, 3, \"similares a los campeonatos de Pokémon Stadium.\"], [101, 3, \"Este servicio cuenta con combates para Pika \"], [401, 3, \"Copa, Mini Copa, Poké Copa y Peque Copa. Cada \"], [401, 3, \"copa tienes sus reglas propias y restricciones.\"], [119, 3, \"Top\"], [0, 3], [412, 2], [111, 2, 1, 1, 0, 1, 0], [101, 3, \"La Pika Copa está abierta para Pokémon de nivel \"], [401, 3, \"15 al 20.\"], [101, 3, \"Elige tres Pokémon para participar.\\\\nSin \"], [401, 3, \"embargo, la suma de los niveles de los tres no \"], [401, 3, \"puede ser mayor a 50.\"], [101, 3, \"Además, no pueden participar algunas especies \"], [401, 3, \"exóticas.\"], [119, 3, \"Top\"], [0, 3], [412, 2], [111, 2, 1, 1, 0, 2, 0], [101, 3, \"La Mini Copa está abierta para Pokémon no \"], [401, 3, \"evolucionados de nivel 25 al 30.\"], [101, 3, \"Elige tres Pokémon para participar.\\\\nSin \"], [401, 3, \"embargo, la suma de los niveles de los tres no \"], [401, 3, \"puede ser mayor a 80.\"], [101, 3, \"Además, varios Pokémon muy grantes o altos no \"], [401, 3, \"pueden participar de la Mini Copa.\"], [101, 3, \"El límite de altura es 2 metros y el de peso es \"], [401, 3, \"20 kilogramos.\"], [119, 3, \"Top\"], [0, 3], [412, 2], [111, 2, 1, 1, 0, 3, 0], [101, 3, \"La Poké Copa está abierta para Pokémon de nivel \"], [401, 3, \"50 al 55.\"], [101, 3, \"Elige tres Pokémon para participar.\\\\nSin \"], [401, 3, \"embargo, la suma de los niveles de los tres no \"], [401, 3, \"puede ser mayor a 155.\"], [101, 3, \"Además, no pueden participar algunas especies \"], [401, 3, \"exóticas.\"], [119, 3, \"Top\"], [0, 3], [412, 2], [111, 2, 1, 1, 0, 4, 0], [101, 3, \"La Peque Copa está abierta para crías Pokémon de \"], [401, 3, \"nivel 5 que sean capaces de evolucionar.\"], [101, 3, \"Elige tres Pokémon para participar en una \"], [401, 3, \"batalla individual o cuatro para una batalla \"], [401, 3, \"doble.\"], [101, 3, \"Además, en la Peque Copa, los movimientos que \"], [401, 3, \"inflingen cierta cantidad de daño, como Furia \"], [401, 3, \"Dragón y Bomba Sónica, fallarán siempre.\"], [119, 3, \"Top\"], [0, 3], [412, 2], [111, 2, 1, 1, 0, 5, 0], [101, 3, \"En las Copas del Estadio, hay varias reglas a \"], [401, 3, \"tener en cuenta.\"], [101, 3, \"La primera, dos Pokémon del mismo equipo no \"], [401, 3, \"pueden quedar ambos dormidos o congelados al \"], [401, 3, \"mismo tiempo.\"], [101, 3, \"La segunda, no puedes elegir dos Pokémon de la \"], [401, 3, \"misma especie, y tampoco pueden llevar dos \"], [401, 3, \"objetos iguales.\"], [101, 3, \"Finalmente, si un Pokémon usa Autodestrucción o \"], [401, 3, \"Explosión y se debilitan todos los Pokémon al \"], [401, 3, \"mismo tiempo, el entrenador de ese Pokémon \"], [401, 3, \"perderá.\"], [119, 3, \"Top\"], [0, 3], [412, 2], [0, 2], [402, 1, 1, \"Reproducir el combate grabado\"], [111, 2, 12, \"$PokemonGlobal.lastbattle!=nil\"], [355, 3, \"pbPlayLastBattle\"], [0, 3], [411, 2], [101, 3, \"No hay ningún combate grabado.\"], [0, 3], [412, 2], [0, 2], [402, 1, 2, \"Salir\"], [0, 2], [404, 1], [0, 1], [412, 0], [0, 0]]}]"}]},{"id":8,"name":"Ascensor Individuales","type":"evento","point":true,"x":80.0,"y":48.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"id","type":"string","value":"8"},{"name":"vision","type":"string","value":"0"},{"name":"paginas","type":"string","value":"[{\"cond\": {}, \"grafico\": \"doors9\", \"dir\": 2, \"patron\": 1, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[0, 0]]}]"}]},{"id":9,"name":"Ascensor Dobles","type":"evento","point":true,"x":528.0,"y":48.0,"width":0,"he
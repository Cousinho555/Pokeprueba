 [0, 3], [412, 2], [101, 2, \"\\\\r¿Qué Pokémon quieres que criemos por ti?\"], [355, 2, \"pbChooseNonEggPokemon(1,3)\"], [111, 2, 1, 1, 0, 0, 4], [101, 3, \"\\\\rBien, ¡hasta la próxima!\"], [115, 3], [0, 3], [412, 2], [111, 2, 12, \"!pbCheckAble(pbGet(1))\"], [101, 3, \"\\\\rSi me dejas ese Pokémon, ¿con quién te vas a \"], [401, 3, \"defender?\"], [101, 3, \"\\\\rRegresa en otro momento.\"], [115, 3], [0, 3], [412, 2], [355, 2, \"pbDayCareDeposit(pbGet(1))\"], [101, 2, \"\\\\rMuy bien. Cuidaremos durante una temporada de \"], [401, 2, \"tu \\\\v[3], tal y como nos has indicado.\"], [118, 2, \"RaiseAnother\"], [101, 2, \"\\\\rPodemos cuidar a dos de tus Pokémon. ¿Quieres \"], [401, 2, \"que nos ocupemos de otro?\"], [102, 2, [\"Si\", \"No\"], 2], [402, 2, 0, \"Si\"], [111, 3, 12, \"$Trainer.pokemonCount<=1\"], [101, 4, \"\\\\r¡Alto! Si me entregas ese Pokémon, no tendrás \"], [401, 4, \"ninguno con el que lugar.\\\\nVuelve cuando lleves \"], [401, 4, \"más Pokémon contigo.\"], [115, 4], [0, 4], [412, 3], [101, 3, \"\\\\r¿Qué Pokémon quieres que criemos por ti?\"], [355, 3, \"pbChooseNonEggPokemon(1,3)\"], [111, 3, 1, 1, 0, 0, 4], [101, 4, \"\\\\rBien, ¡hasta la próxima!\"], [115, 4], [0, 4], [412, 3], [111, 3, 12, \"!pbCheckAble(pbGet(1))\"], [101, 4, \"\\\\rSi me dejas ese Pokémon, ¿con quién te vas a \"], [401, 4, \"defender?\"], [101, 4, \"\\\\rRegresa en otro momento.\"], [115, 4], [0, 4], [412, 3], [355, 3, \"pbDayCareDeposit(pbGet(1))\"], [101, 3, \"\\\\rMuy bien. Cuidaremos durante una temporada de \"], [401, 3, \"tu \\\\v[3], tal y como nos has indicado.\"], [101, 3, \"\\\\rPásate a retirarlo cuando quieras, ¿de \"], [401, 3, \"acuerdo?\"], [0, 3], [402, 2, 1, \"No\"], [111, 3, 2, \"A\", 0], [119, 4, \"TakeBack\"], [0, 4], [411, 3], [101, 4, \"\\\\rBien, ¡hasta la próxima!\"], [0, 4], [412, 3], [0, 3], [404, 2], [0, 2], [402, 1, 1, \"No\"], [101, 2, \"\\\\rBien, ¡hasta la próxima!\"], [0, 2], [404, 1], [0, 1], [411, 0], [101, 1, \"\\\\r¡Ah, eres tú! ¡Me alegro de verte! Y tú te \"], [401, 1, \"alegrarás de saber esto...\"], [111, 1, 12, \"pbDayCareGetLevelGain(0,3,4) && $game_variables[4]>1\"], [101, 2, \"\\\\rTu \\\\v[3] ha crecido rápidamente unos \\\\v[4] \"], [401, 2, \"niveles.\"], [0, 2], [411, 1], [111, 2, 12, \"$game_variables[4]==1\"], [101, 3, \"\\\\rTu \\\\v[3] se ha esforzado para crecer un nivel.\"], [0, 3], [411, 2], [101, 3, \"\\\\rTu \\\\v[3] se encuentra tan bien como cuando lo \"], [401, 3, \"dejaste.\"], [0, 3], [412, 2], [0, 2], [412, 1], [111, 1, 12, \"pbDayCareGetLevelGain(1,3,4) && $game_variables[4]>1\"], [101, 2, \"\\\\rTu \\\\v[3] ha crecido rápidamente unos \\\\v[4] \"], [401, 2, \"niveles.\"], [0, 2], [411, 1], [111, 2, 12, \"$game_variables[4]==1\"], [101, 3, \"\\\\rTu \\\\v[3] se ha esforzado para crecer un nivel.\"], [0, 3], [411, 2], [101, 3, \"\\\\rTu \\\\v[3] se encuentra tan bien como cuando lo \"], [401, 3, \"dejaste.\"], [0, 3], [412, 2], [0, 2], [412, 1], [111, 1, 12, \"Kernel.pbDayCareDeposited==1\"], [123, 2, \"A\", 0], [119, 2, \"RaiseAnother\"], [0, 2], [411, 1], [118, 2, \"TakeBack\"], [101, 2, \"\\\\r¿Quieres de regreso un Pokémon?\"], [102, 2, [\"Si\", \"No\"], 2], [402, 2, 0, \"Si\"], [118, 3, \"TakeBackChosen\"], [111, 3, 12, \"$Trainer.party.length>=6\"], [101, 4, \"\\\\rTu equipo Pokémon está completo. Haz un hueco \"], [401, 4, \"y vuelve a verme.\"], [115, 4], [0, 4], [412, 3], [355, 3, \"pbDayCareChoose(\\n_I(\\\"¿A quién quieres llevarte?\\\"),1)\"], [111, 3, 1, 1, 0, 0, 4], [101, 4, \"\\\\rBien, ¡hasta la próxima!\"], [115, 4], [0, 4], [412, 3], [355, 3, \"pbDayCareGetDeposited(pbGet(1),3,4)\"], [101, 3, \"\\\\G\\\\rSi quieres llevarte tu \\\\v[3], tendrás que \"], [401, 3, \"pagar $ \\\\v[4].\"], [102, 3, [\"Si\", \"No\"], 2], [402, 3, 0, \"Si\"], [122, 4, 5, 5, 0, 7, 2], [111, 4, 1, 5, 1, 4, 4], [101, 5, \"\\\\G\\\\rNo tienes suficiente dinero...\"], [115, 5], [0, 5], [412, 4], [125, 4, 1, 1, 4], [355, 4, \"pbDayCareWithdraw(pbGet(1))\"], [101, 4, \"\\\\G\\\\r¡P
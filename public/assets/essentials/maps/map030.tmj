 [412, 1], [101, 1, \"\\\\bHoy es \\\\v[1].\"], [101, 1, \"\\\\bEso significa que el Concurso Cazabichos es \"], [401, 1, \"hoy.\"], [101, 1, \"\\\\bLas reglas son simples.\"], [101, 1, \"\\\\bUsando a uno de tus Pokémon, captura un \"], [401, 1, \"Pokémon de tipo Bicho para competir.\"], [101, 1, \"\\\\b¿Quisieras intentarlo?\"], [102, 1, [\"Si\", \"No\"], 2], [402, 1, 0, \"Si\"], [111, 2, 12, \"pbBoxesFull?\"], [101, 3, \"\\\\bLo siento, las cajas de tu PC están llenas.\"], [115, 3], [0, 3], [412, 2], [101, 2, \"\\\\bPuedes entrar al Concurso con un sólo Pokémon.\"], [101, 2, \"\\\\bPor favor, escoge con cuál participar.\"], [108, 2, \"Opens a screen for choosing a Pokémon except those \"], [355, 2, \"pbChooseAblePokemon(1,2)\"], [111, 2, 1, 1, 0, 0, 4], [108, 3, \"Cancelled choosing a Pokémon.\"], [101, 3, \"\\\\bDe acuerdo. Esperamos que quieras participar \"], [401, 3, \"en el siguiente concurso.\"], [115, 3], [0, 3], [411, 2], [101, 3, \"\\\\bEntonces, participarás con \\\\v[2].\"], [101, 3, \"\\\\bCuidaremos de los otros Pokémon durante el \"], [401, 3, \"concurso.\"], [101, 3, \"Los Pokémon de \\\\PN fueron dejados al Anfitrión \"], [401, 3, \"del Concurso.\\\\se[expfull]\\\\wtnp[20]\"], [101, 3, \"\\\\bAquí están las Competición Balls del concurso.\"], [101, 3, \"\\\\PN recibió 20 Competición Balls.\\\\se\"], [401, 3, \"[itemlevel]\\\\wtnp[20]\"], [101, 3, \"\\\\bEl participante que gane el bicho Pokémon más \"], [401, 3, \"fuerte será el ganador.\"], [101, 3, \"\\\\bTienes 20 minutos.\"], [101, 3, \"\\\\bSi te quedas sin Sport Balls, habrás \"], [401, 3, \"terminado.\"], [101, 3, \"\\\\bPuedes quedarte con el último Pokémon como \"], [401, 3, \"propio.\"], [101, 3, \"\\\\b¡Adelante y atrapa al Pokémon tipo Bicho más \"], [401, 3, \"fuerte que encuentres!\"], [108, 3, \"Setting the map, X and Y where the Contest is \"], [355, 3, \"pbBugContestState.pbSetJudgingPoint(30,5,6)\\npbBugContestState.pbSetReception(29,30)\\npbBugContestState.pbSetContestMap(28)\\n
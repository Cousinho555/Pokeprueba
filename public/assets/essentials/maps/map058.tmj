pbEntryScreen(3,100)\"], [119, 2, \"End\"], [0, 2], [412, 1], [111, 1, 12, \"pbSaveScreen\"], [101, 2, \"\\\\b¡Sígueme, por favor!\"], [355, 2, \"pbBattleChallenge.start\"], [209, 2, 0, {\"repite\": false, \"salta\": false, \"lista\": [[37, []], [15, [4]], [19, []], [4, []], [4, []], [42, [0]], [38, []], [0, []]]}], [209, 2, -1, {\"repite\": false, \"salta\": false, \"lista\": [[37, []], [15, [4]], [19, []], [4, []], [4, []], [4, []], [42, [0]], [38, []], [0, []]]}], [210, 2], [250, 2, {\"nombre\": \"Exit Door\", \"volumen\": 80, \"tono\": 100}], [223, 2, [-255.0, -255.0, -255.0, 0.0], 6], [106, 2, 8], [201, 2, 0, 59, 2, 8, 0, 1], [223, 2, [0.0, 0.0, 0.0, 0.0], 6], [0, 2], [411, 1], [119, 2, \"End\"], [0, 2], [412, 1], [0, 1], [402, 0, 1, \"No\"], [118, 1, \"End\"], [101, 1, \"\\\\bEsperamos que vuelvas pronto por aquí.\"], [355, 1, \"pbBattleChallenge.pbCancel\"], [115, 1], [0, 1], [404, 0], [0, 0]]}, {\"cond\": {\"s1\": 28}, \"grafico\": \"trchar016\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 3, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[108, 0, \"Si gana\"], [111, 0, 12, \"pbBattleChallenge.decision==1\"], [101, 1, \"\\\\bFelicitaciones por la victoria.\"], [101, 1, \"\\\\bAquí tienes este premio.\"], [111, 1, 12, \"!Kernel.pbReceiveItem(PBItems::RARECANDY)\"], [101, 2, \"\\\\bNo tienes espacio. Al menos, has ganado.\"], [0, 2], [412, 1], [111, 1, 12, \"$PokemonTemp.lastbattle!=nil\"], [101, 2, \"\\\\b¿Quieres grabar tu último combate?\"], [102, 2, [\"Si\", \"No\"], 2], [402, 2, 0, \"Si\"], [355, 3, \"pbRecordLastBattle\"], [101, 3, \"\\\\se[expfull]El último combate ha sido grabado.\"], [0, 3], [402, 2, 1, \"No\"], [0, 3], [404, 2], [0, 2], [412, 1], [101, 1, \"Vamos a grabar tu resultado.\\\\wtnp[15]\"], [355, 1, \"pbBattleChallenge.pbEnd\"], [101, 1, \"\\\\bEsperamos que vuelvas pronto por aquí.\"], [115, 1], [0, 1], [412, 0], [108, 0, \"Si pierde o empata\"], [111, 0, 12, \"pbBattleChallenge.decision==2\"], [101, 1, \"\\\\b¡Gracias por participar!\"], [111, 1, 12, \"$PokemonTemp.lastbattle!=nil\"], [101, 2, \"\\\\b¿Quieres grabar tu último combate?\"], [102, 2, [\"Si\", \"No\"], 2], [402, 2, 0, \"Si\"], [355, 3, \"pbRecordLastBattle\"], [101, 3, \"\\\\se[expfull]El último combate ha sido grabado.\"], [0, 3], [402, 2, 1, \"No\"], [0, 3], [404, 2], [0, 2], [412, 1], [101, 1, \"Vamos a grabar tu resultado.\\\\wtnp[15]\"], [355, 1, \"pbBattleChallenge.pbEnd\"], [101, 1, \"\\\\bEsperamos que vuelvas pronto por aquí.\"], [115, 1], [0, 1], [412, 0], [111, 0, 12, \"pbBattleChallenge.pbResting?\"], [101, 1, \"\\\\bTe estábamos esperando. Sígueme por aquí.\"], [355, 1, \"pbBattleChallenge.pbGoOn\"], [209, 1, 0, {\"repite\": false, \"salta\": false, \"lista\": [[37, []], [15, [4]], [19, []], [4, []], [4, []], [42, [0]], [38, []], [0, []]]}], [209, 1, -1, {\"repite\": false, \"salta\": false, \"lista\": [[37, []], [15, [4]], [19, []], [4, []], [4, []], [4, []], [42, [0]], [38, []], [0, []]]}], [210, 1], [250, 1, {\"nombre\": \"Exit Door\", \"volumen\": 80, \"tono\": 100}], [223, 1, [-255.0, -255.0, -255.0, 0.0], 6], [106, 1, 8], [201, 1, 0, 59, 2, 8, 0, 1], [223, 1, [0.0, 0.0, 0.0, 0.0], 6], [0, 1], [411, 0], [101, 1, \"\\\\bDisculpa, pero no has guardado la partida al \"], [401, 1, \"terminar el último combate.\"], [101, 1, \"\\\\bLo siento, pero el desafío ha sido cancelado.\"], [355, 1, \"pbBattleChallenge.pbEnd\"], [0, 1], [412, 0], [0, 0]]}]"}]},{"id":4,"name":"Resultados Indiv","type":"evento","point":true,"x":176.0,"y":112.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"id","type":"string","value":"4"},{"name":"vision","type":"string","value":"0"},{"name":"paginas","type":"string","value":"[{\"cond\": {}, \"grafico\": \"invisible\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[101, 0, \"¿De qué desafío quieres revisar los resultados?\"], [102, 0, [\"Nivel 50\", \"Nivel Libre\", \"Salir\"], 3], [402, 0, 0, \"Nivel 50\"], [355, 1, \"$game_variables[1]=\\npbBattleChallenge.getPreviousWins(\\\"palacesingle\\\")\\n$game_variables[2]=\\npbBattleChallenge.getMaxWins(\\\"palacesingle\\\")\"], [101, 1, \"Resultados de \\\\PN en Batalla Individual de Nivel \"], [401, 1, \"50 en el Palacio Batalla:\"], [101, 1, \"Racha previa: \\\\v[1]\\\\nRacha récord: \\\\v[2]\"], [0, 1], [402, 0, 1, \"Nivel Libre\"], [355, 1, \"$game_variables[1]=\\npbBattleChallenge.getPreviousWins(\\\"palacesingleopen\\\")\\n$game_variables[2]=\\npbBattleChallenge.getMaxWins(\\\"palacesingleopen\\\")\"], [101, 1, \"Resultados de \\\\PN en Batalla Individual de Nivel \"], [401, 1, \"Libre en el Palacio Batalla:\"], [101, 1, \"Racha previa: \\\\v[1]\\\\nRacha récord: \\\\v[2]\"], [0, 1], [402, 0, 2, \"Salir\"], [0, 1], [404, 0], [0, 0]]}]"}]},{"id":5,"name":"Batalla grabada","type":"evento","point":true,"x":272.0,"y":112.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"id","type":"string","value":"5"},{"name":"vision","type":"string","value":"0"},{"name":"paginas","type":"string","value":"[{\"cond\": {}, \"grafico\": \"invisible\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[111, 0, 6, -1, 8], [102, 1, [\"Reglas del Palacio Batalla\", \"Reproducir el combate grabado\", \"Salida\"], 3], [402, 1, 0, \"Reglas del Palacio Batalla\"], [118, 2, \"Top\"], [101, 2, \"¿Qué capítulo quieres leer?\\\\ch[1,-1,Lo \"], [401, 2, \"Básico,Naturaleza Pokémon,Movimientos \"], [401, 2, \"Pokémon,Ataques Inadecuados,En Peligro,Salir]\"], [111, 2, 1, 1, 0, 0, 0], [101, 3, \"En el Palacio Batalla, los Pokémon deberán \"], [401, 3, \"pensar y combatir por sí mismos.\"], [101, 3, \"A diferencia de los Pokémon salvajes, los que \"], [401, 3, \"viven con gente se comportan de manera distinta \"], [401, 3, \"según su naturaleza.\"], [119, 3, \"Choices\"], [0, 3], [412, 2], [111, 2, 1, 1, 0, 1, 0], [101, 3, \"Según su naturaleza, un Pokémon puede atacar sin \"], [401, 3, \"medir las consecuencias.\"], [101, 3, \"Mientras que otro preferiría protegerse en lugar \"], [401, 3, \"de atacar.\"], [101, 3, \"Y otro puede que prefiera irritar o confundir a \"], [401, 3, \"sus oponentes.\"], [101, 3, \"Según su naturaleza, cada Pokémon tendrá unos \"], [401, 3, \"movimientos preferidos, que sabrá usar muy bien.\"], [119, 3, \"Choices\"], [0, 3], [412, 2], [111, 2, 1, 1, 0, 2, 0], [101, 3, \"Existen movimientos ofensivos que inflingen un \"], [401, 3, \"daño directo al enemigo.\"], [101, 3, \"Hay movimientos defensivos que sirven para \"], [401, 3, \"prepararse ante ataques enemigos, curar PS, etc.\"], [101, 3, \"Existen también otros movimientos que pueden \"], [401, 3, \"alterar el estado del rival con envenenamiento, \"], [401, 3, \"parálisis, etc.\"], [101, 3, \"Los Pokémon usarán movimientos de una de estas \"], [401, 3, \"tres categorías.\"], [119, 3, \"Choices\"], [0, 3], [412, 2], [111, 2, 1, 1, 0, 3, 0], [101, 3, \"Cuando no está bajo el control de su Entrenador, \"], [401, 3, \"un Pokémon puede ser incapaz de usar ciertos \"], [401, 3, \"movimientos.\"], [101, 3, \"A los Pokémon no les gusta usar movimientos \"], [401, 3, \"impropios de su naturaleza.\"], [101, 3, \"Si un Pokémon sólo conoce movimientos ajenos a \"], [401, 3, \"su naturaleza, es probable que nunca llegue a \"], [401, 3, \"demostrar su valía.\"], [119, 3, \"Choices\"], [0, 3], [412, 2], [111, 2, 1, 1, 0, 4, 0], [101, 3, \"Cuando un Pokémon está en peligro, es posible \"], [401, 3, \"que decida usar movimientos que sean ajenos a su \"], [401, 3, \"naturaleza.\"], [101, 3, \"Si un Pokémon comienza a comportarse de modo \"], [401, 3, \"extraño en un momento de apuro, no lo pierdas de \"], [401, 3, \"vista.\"], [119, 3, \"Choices\"], [0, 3], [412, 2], [0, 2], [402, 1, 1, \"Reproducir el combate grabado\"], [111, 2, 12, \"$PokemonGlobal.lastbattle!=nil\"], [355, 3, \"pbPlayLastBattle\"], [0, 3], [411, 2], [101, 3, \"No hay ningún combate grabado.\"], [0, 3], [412, 2], [0, 2], [402, 1, 2, \"Salida\"], [0, 2], [404, 1], [0, 1], [412, 0], [0, 0]]}]"}]},{"id":6,"name":"PNJ Batallas Dobles","type":"evento","point":true,"x":368.0,"y":112.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"id","type":"string","value":"6"},{"name":"vision","type":"string","value":"0"},{"name":"paginas","type":"string","value":"[{\"cond\": {}, \"grafico\": \"trchar016\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[101, 0, \"\\\\b¡Te doy la bienvenida al Palacio Batalla!\"], [101, 0, \"\\\\b¿Quieres participar en una batalla doble?\"], [102, 0, [\"Si\", \"No\"], 2], [402, 0, 0, \"Si\"], [101, 1, \"\\\\bEn el Palacio Batalla hay dos categorías: \"], [401, 1, \"nivel 50 y nivel libre. ¿Cuál prefieres?\"], [102, 1, [\"Nivel 50\", \"Nivel Libre\", \"Salir\"], 3], [402, 1, 0, \"Nivel 50\"], [355, 2, \"pbBattleChallenge.set(\\\"palacedouble\\\",7,\\npbBattlePalaceRules(true,false))\"], [0, 2], [402, 1, 1, \"Nivel Libre\"], [355, 2, \"pbBattleChallenge.set(\\\"palacedoubleopen\\\",7,\\npbBattlePalaceRules(true,true))\"], [0, 2], [402, 1, 2, \"Salir\"], [119, 2, \"End\"], [0, 2], [404, 1], [108, 1, \"Has 3 or more eligible Pokemon level 100 or less?\"], [111, 1, 12, \"!pbHasEligible?(3,100)\"], [101, 2, \"\\\\bLo siento, no puedes participar. Necesitas \"], [401, 2, \"tres Pokémon diferentes para participar.\"], [101, 2, \"\\\\bEllos deben ser de especies distintas y llevar \"], [401, 2, \"objetos diferentes.\"], [101, 2, \"\\\\bNo se puede participar con determinadas \"], [401, 2, \"especies exóticas ni con huevos.\"], [119, 2, \"End\"], [0, 2], [412, 1], [101, 1, \"\\\\bSelecciona los tres Pokémon con los que \"], [401, 1, \"quieres combatir.\"], [111, 1, 12, \"!pbEntryScreen(3,100)\"], [119, 2, \"End\"], [0, 2], [412, 1], [111, 1, 12, \"pbSaveScreen\"], [101, 2, \"\\\\b¡Sígueme, por favor!\"], [355, 2, \"pbBattleChallenge.start\"], [209, 2, 0, {\"repite\": false, \"salta\": false, \"lista\": [[37, []], [15, [4]], [19, []], [4, []], [4, []], [42, [0]], [38, []], [0, []]]}], [209, 2, -1, {\"repite\": false, \"salta\": false, \"lista\": [[37, []], [15, [4]], [19, []], [4, []], [4, []], [4, []], [42, [0]], [38, []], [0, []]]}], [210, 2], [250, 2, {\"nombre\": \"Exit Door\", \"volumen\": 80, \"tono\": 100}], [223, 2, [-255.0, -255.0, -255.0, 0.0], 6], [106, 2, 8], [201, 2, 0, 59, 2, 8, 0, 1], [223, 2, [0.0, 0.0, 0.0, 0.0], 6], [0, 2], [411, 1], [119, 2, \"End\"], [0, 2], [412, 1], [0, 1], [402, 0, 1, \"No\"], [118, 1, \"End\"], [101, 1, \"\\\\bEsperamos que vuelvas pronto por aquí.\"], [355, 1, \"pbBattleChallenge.pbCancel\"], [115, 1], [0, 1], [404, 0], [0, 0]]}, {\"cond\": {\"s1\": 28}, \"grafico\": \"trchar016\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 3, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[108, 0, \"Si gana\"], [111, 0, 12, \"pbBattleChallenge.decision==1\"], [101, 1, \"\\\\bFelicitaciones por la victoria.\"], [101, 1, \"\\\\bAquí tienes este premio.\"], [111, 1, 12, \"!Kernel.pbReceiveItem(PBItems::RARECANDY)\"], [101, 2, \"\\\\bNo tienes espacio. Al menos, has ganado.\"], [0, 2], [412, 1], [111, 1, 12, \"$PokemonTemp.lastbattle!=nil\"], [101, 2, \"\\\\b¿Quieres grabar tu último combate?\"], [102, 2, [\"Si\", \"No\"], 2], [402, 2, 0, \"Si\"], [355, 3, \"pbRecordLastBattle\"], [101, 3, \"\\\\se[expfull]El último combate ha sido grabado.\"], [0, 3], [402, 2, 1, \"No\"], [0, 3], [404, 2], [0, 2], [412, 1], [101, 1, \"Vamos a grabar tu resultado.\\\\wtnp[15]\"], [355, 1, \"pbBattleChallenge.pbEnd\"], [101, 1, \"\\\\bEsperamos que vuelvas pronto por aquí.\"], [115, 1], [0, 1], [412, 0], [108, 0, \"Si pierte o empata\"], [111, 0, 12, \"pbBattleChallenge.decision==2\"], [101, 1, \"\\\\b¡Gracias por participar!\"], [111, 1, 12, \"$PokemonTemp.lastbattle!=nil\"], [101, 2, \"\\\\b¿Quieres grabar tu último combate?\"], [102, 2, [\"Si\", \"No\"], 2], [402, 2, 0, \"Si\"], [355, 3, \"pbRecordLastBattle\"], [101, 3, \"\\\\se[expfull]El último combate ha sido grabado.\"], [0, 3], [402, 2, 1, \"No\"], [0, 3], [404, 2], [0, 2], [412, 1], [101, 1, \"Vamos a grabar tu resultado.\\\\wtnp[15]\"], [355, 1, \"pbBattleChallenge.pbEnd\"], [101, 1, \"\\\\bEsperamos que vuelvas pronto por aquí.\"], [115, 1], [0, 1], [412, 0], [111, 0, 12, \"pbBattleChallenge.pbResting?\"], [101, 1, \"\\\\bTe estábamos esperando. Sígueme por aquí.\"], [355, 1, \"pbBattleChallenge.pbGoOn\"], [209, 1, 0, {\"repite\": false, \"salta\": false, \"lista\": [[37, []], [15, [4]], [19, []], [4, []], [4, []], [42, [0]], [38, []], [0, []]]}], [209, 1, -1, {\"repite\": false, \"salta\": false, \"lista\": [[37, []], [15, [4]], [19, []], [4, []], [4, []], [4, []], [42, [0]], [38, []], [0, []]]}], [210, 1], [250, 1, {\"nombre\": \"Exit Door\", \"volumen\": 80, \"tono\": 100}], [223, 1, [-255.0, -255.0, -255.0, 0.0], 6], [106, 1, 8], [201, 1, 0, 59, 2, 8, 0, 1], [223, 1, [0.0, 0.0, 0.0, 0.0], 6], [0, 1], [411, 0], [101, 1, \"\\\\bDisculpa, pero no has guardado la partida al \"], [401, 1, \"terminar el último combate.\"], [101, 1, \"\\\\bLo siento, pero el desafío ha sido cancelado.\"], [355, 1, \"pbBattleChallenge.pbEnd\"], [0, 1], [412, 0], [0, 0]]}]"}]},{"id":7,"name":"Resultados Dobles","type":"evento","point":true,"x":432.0,"y":112.0,"width":0,"height":0,"rotation":0,"visible":true,"properties":[{"name":"id",
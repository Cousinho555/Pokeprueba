RN,\\n:GRNAPRICORN,:PNKAPRICORN,:WHTAPRICORN,\\n:BLKAPRICORN)\"], [111, 0, 1, 8, 0, -1, 0], [108, 1, \"El jugador canceló la elección del Bonguri.\"], [101, 1, \"\\\\bAvísame cuando quieras que te convierta un \"], [401, 1, \"Bonguri.\"], [0, 1], [411, 0], [111, 1, 1, 8, 0, 0, 0], [108, 2, \"El jugador no tiene Bonguris.\"], [101, 2, \"\\\\bRegresa cuando tengas un Bonguri.\"], [0, 2], [411, 1], [108, 2, \"El jugador elige un Bonguri.\"], [355, 2, \"$PokemonBag.pbDeleteItem(pbGet(8))\"], [355, 2, \"pbSet(3,PBItems.getName(pbGet(8)))\"], [101, 2, \"\\\\bDe acuerdo. Convertiré tu \\\\v[3] en una Poké \"], [401, 2, \"Ball.\"], [101, 2, \"\\\\bEstaré terminando esto mañana.\"], [108, 2, \"Convierte el Bonguri en Ball ahora.\"], [355, 2, \"pbConvertItemToItem(8,[\\n   :REDAPRICORN,:LEVELBALL,\\n   :YLWAPRICORN,:MOONBALL,\\n   :BLUAPRICORN,:LUREBALL,\\n   :GRNAPRICORN,:FRIENDBALL,\\n   :PNKAPRICORN,:LOVEBALL,\\n   :WHTAPRICORN,:FASTBALL,\\n   :BLKAPRICORN,:HEAVYBALL])\"], [355, 2, \"pbSetEventTime\"], [0, 2], [412, 1], [0, 1], [412, 0], [0, 0]]}, {\"cond\": {\"ss\": \"B\"}, \"grafico\": \"NPC 18\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[111, 0, 1, 8, 0, 0, 3], [101, 1, \"\\\\bTe estaba esperando. Ya terminé la Poké Ball \"], [401, 1, \"que me pediste que haga.\"], [111, 1, 12, \"Kernel.pbReceiveItem(pbGet(8))\"], [122, 2, 8, 8, 0, 0, 0], [123, 2, \"B\", 1], [0, 2], [411, 1], [101, 2, \"\\\\bNo te queda espacio en la mochila. Regresa \"], [401, 2, \"cuando lo tengas.\"], [0, 2], [412, 1], [0, 1], [411, 0], [101, 1, \"\\\\bIntenté hacer una Poké Ball con lo que me \"], [401, 1, \"diste, pero no funcionó.\"], [101, 1, \"\\\\bLo siento.\"], [123, 1, \"B\", 1], [0, 1], [412, 0], [0, 0]]}, {\"cond\": {\"ss\": \"A\"}, \"grafico\": \"NPC 18\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 0, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[101, 0, \"\\\\bTodavía estoy trabajando con tu Bonguri. \"], [401, 0, \"Regresa después.\"], [0, 0]]}, {\"cond\": {\"s1\": 23}, \"grafico\": \"NPC 18\", \"dir\": 2, \"patron\": 0, \"tile\": 0, \"opacidad\": 255, \"disparo\": 3, \"atraviesa\": false, \"fijo\": false, \"anda\": true, \"paso\": false, \"encima\": false, \"mov\": 0, \"vel\": 3, \"frec\": 3, \"ruta\": null, \"lista\": [[123, 0, \"A\", 1], [123, 0, \"B\", 0], [355, 0, \"setTempSwitchOn(\\\"A\\\")\"], [0, 0]]}]"}]}]}],"tilesets":[{"firstgid":1,"name":"autotiles3","image":"../autotiles/3.png","imagewidth":256,"imageheight":1344,"tilewidth":32,"tileheight":32,"tilecount":336,"columns":8,"margin":0,"spacing":0},{"firstgid":337,"name":"Interior general","image":"../tilesets/Interior general.png","imagewidth":2048,"imageheight":1024,"tilewidth":32,"tileheight":32,"tilecount":2048,"columns":64,"margin":0,"spacing":0}]}